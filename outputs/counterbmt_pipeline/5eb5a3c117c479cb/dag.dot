digraph GroundedDAG {
    rankdir=TB;
    node [shape=box, style=filled];

    // Layer 0: Initial States
    subgraph cluster_0 {
        label="Layer 0: Initial States";
        style=dashed;
        "ego_initial_position" [label="Ego Initial Position\n{'x': 0.0, 'y': 0.0}", fillcolor=skyblue];
        "ego_initial_speed" [label="Ego Initial Speed\n2.1307804584503174", fillcolor=skyblue];
        "ego_initial_heading" [label="Ego Initial Heading\n0.4491334557533264", fillcolor=skyblue];
        "agent_512_state" [label="Vehicle agent_512\n{'position': (11076.", fillcolor=plum];
        "agent_513_state" [label="Vehicle agent_513\n{'position': (10986.", fillcolor=plum];
        "agent_514_state" [label="Vehicle agent_514\n{'position': (11027.", fillcolor=plum];
        "agent_515_state" [label="Vehicle agent_515\n{'position': (11092.", fillcolor=plum];
        "agent_516_state" [label="Vehicle agent_516\n{'position': (11082.", fillcolor=plum];
    }

    // Layer 1: Events
    subgraph cluster_1 {
        label="Layer 1: Events";
        style=dashed;
        "maneuver_0" [label="Maneuver: straight\nstraight", fillcolor=turquoise];
        "maneuver_1" [label="Maneuver: left_turn\nleft_turn", fillcolor=turquoise];
        "maneuver_2" [label="Maneuver: straight\nstraight", fillcolor=turquoise];
        "decision_0" [label="Decision: proceed_or_yield\nproceed through intersection", fillcolor=coral];
        "decision_1" [label="Decision: lane_choice\nstay in current lane", fillcolor=coral];
        "decision_2" [label="Decision: gap_acceptance\naccept gap to merge", fillcolor=coral];
    }

    // Layer 2: Outcome
    subgraph cluster_2 {
        label="Layer 2: Outcome";
        style=dashed;
        "collision_outcome" [label="Collision Outcome", fillcolor=orange];
    }

    "ego_initial_position" -> "maneuver_0" [label="0.80"];
    "ego_initial_speed" -> "maneuver_0" [label="0.80"];
    "ego_initial_heading" -> "maneuver_0" [label="0.80"];
    "agent_512_state" -> "decision_0" [label="0.70"];
    "agent_513_state" -> "decision_0" [label="0.90"];
    "agent_514_state" -> "decision_0" [label="0.70"];
    "agent_515_state" -> "decision_0" [label="0.70"];
    "agent_516_state" -> "decision_0" [label="0.70"];
    "maneuver_0" -> "maneuver_1" [label="0.90"];
    "maneuver_1" -> "maneuver_2" [label="0.90"];
    "decision_0" -> "maneuver_1" [label="0.90"];
    "decision_1" -> "maneuver_2" [label="0.80"];
    "decision_2" -> "maneuver_2" [label="0.85"];
    "maneuver_0" -> "collision_outcome" [label="0.70"];
    "maneuver_1" -> "collision_outcome" [label="0.80"];
    "maneuver_2" -> "collision_outcome" [label="0.80"];
    "decision_0" -> "collision_outcome" [label="0.90"];
    "decision_1" -> "collision_outcome" [label="0.80"];
    "decision_2" -> "collision_outcome" [label="0.85"];
}