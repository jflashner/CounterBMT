digraph GroundedDAG {
    rankdir=TB;
    node [shape=box, style=filled];

    // Layer 0: Initial States
    subgraph cluster_0 {
        label="Layer 0: Initial States";
        style=dashed;
        "ego_initial_position" [label="Ego Initial Position\n{'x': 0.0, 'y': 0.0}", fillcolor=skyblue];
        "ego_initial_speed" [label="Ego Initial Speed\n6.391323566436768", fillcolor=skyblue];
        "ego_initial_heading" [label="Ego Initial Heading\n1.3072690963745117", fillcolor=skyblue];
        "agent_1025_state" [label="Vehicle agent_1025\n{'position': (586.31", fillcolor=plum];
        "agent_1026_state" [label="Vehicle agent_1026\n{'position': (617.11", fillcolor=plum];
        "agent_1027_state" [label="Vehicle agent_1027\n{'position': (593.43", fillcolor=plum];
        "agent_1028_state" [label="Vehicle agent_1028\n{'position': (623.61", fillcolor=plum];
        "agent_1029_state" [label="Vehicle agent_1029\n{'position': (579.41", fillcolor=plum];
    }

    // Layer 1: Events
    subgraph cluster_1 {
        label="Layer 1: Events";
        style=dashed;
        "maneuver_0" [label="Maneuver: decelerate\ndecelerate", fillcolor=turquoise];
        "maneuver_1" [label="Maneuver: stop\nstop", fillcolor=turquoise];
        "maneuver_2" [label="Maneuver: left_turn\nleft_turn", fillcolor=turquoise];
        "maneuver_3" [label="Maneuver: accelerate\naccelerate", fillcolor=turquoise];
        "decision_0" [label="Decision: proceed_or_yield\nproceed", fillcolor=coral];
        "decision_1" [label="Decision: lane_choice\nstay in lane", fillcolor=coral];
        "decision_2" [label="Decision: gap_acceptance\naccept gap", fillcolor=coral];
    }

    // Layer 2: Outcome
    subgraph cluster_2 {
        label="Layer 2: Outcome";
        style=dashed;
        "collision_outcome" [label="Collision Outcome", fillcolor=orange];
    }

    "ego_initial_position" -> "maneuver_0" [label="0.80"];
    "ego_initial_speed" -> "maneuver_0" [label="0.90"];
    "ego_initial_heading" -> "maneuver_0" [label="0.70"];
    "agent_1025_state" -> "decision_0" [label="0.85"];
    "agent_1026_state" -> "decision_0" [label="0.75"];
    "agent_1027_state" -> "decision_0" [label="0.75"];
    "agent_1028_state" -> "decision_0" [label="0.75"];
    "agent_1029_state" -> "decision_0" [label="0.75"];
    "maneuver_0" -> "maneuver_1" [label="0.90"];
    "maneuver_1" -> "maneuver_2" [label="0.90"];
    "maneuver_2" -> "maneuver_3" [label="0.90"];
    "decision_0" -> "maneuver_2" [label="0.80"];
    "decision_1" -> "maneuver_3" [label="0.70"];
    "decision_2" -> "maneuver_3" [label="0.90"];
    "maneuver_0" -> "collision_outcome" [label="0.70"];
    "maneuver_1" -> "collision_outcome" [label="0.80"];
    "maneuver_2" -> "collision_outcome" [label="0.85"];
    "maneuver_3" -> "collision_outcome" [label="0.75"];
    "decision_0" -> "collision_outcome" [label="0.90"];
    "decision_1" -> "collision_outcome" [label="0.70"];
    "decision_2" -> "collision_outcome" [label="0.80"];
}