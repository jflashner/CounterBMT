digraph GroundedDAG {
    rankdir=TB;
    node [shape=box, style=filled];

    // Layer 0: Initial States
    subgraph cluster_0 {
        label="Layer 0: Initial States";
        style=dashed;
        "ego_initial_position" [label="Ego Initial Position\n{'x': 0.0, 'y': 0.0}", fillcolor=skyblue];
        "ego_initial_speed" [label="Ego Initial Speed\n11.243804931640625", fillcolor=skyblue];
        "ego_initial_heading" [label="Ego Initial Heading\n-1.5406917333602905", fillcolor=skyblue];
        "agent_857_state" [label="Vehicle agent_857\n{'position': (1210.4", fillcolor=plum];
        "agent_858_state" [label="Vehicle agent_858\n{'position': (1197.2", fillcolor=plum];
        "agent_860_state" [label="Vehicle agent_860\n{'position': (1162.5", fillcolor=plum];
        "agent_861_state" [label="Vehicle agent_861\n{'position': (1151.7", fillcolor=plum];
        "agent_862_state" [label="Vehicle agent_862\n{'position': (1200.1", fillcolor=plum];
    }

    // Layer 1: Events
    subgraph cluster_1 {
        label="Layer 1: Events";
        style=dashed;
        "maneuver_0" [label="Maneuver: straight\nstraight", fillcolor=turquoise];
        "maneuver_1" [label="Maneuver: decelerate\ndecelerate", fillcolor=turquoise];
        "maneuver_2" [label="Maneuver: stop\nstop", fillcolor=turquoise];
        "maneuver_3" [label="Maneuver: accelerate\naccelerate", fillcolor=turquoise];
        "decision_0" [label="Decision: proceed_or_yield\nproceed through intersection", fillcolor=coral];
        "decision_1" [label="Decision: lane_choice\nstay in current lane", fillcolor=coral];
        "decision_2" [label="Decision: speed_choice\nmaintain speed", fillcolor=coral];
        "decision_3" [label="Decision: gap_acceptance\naccept gap to merge", fillcolor=coral];
    }

    // Layer 2: Outcome
    subgraph cluster_2 {
        label="Layer 2: Outcome";
        style=dashed;
        "collision_outcome" [label="Collision Outcome", fillcolor=orange];
    }

    "ego_initial_position" -> "maneuver_0" [label="0.80"];
    "ego_initial_speed" -> "maneuver_0" [label="0.90"];
    "ego_initial_heading" -> "maneuver_0" [label="0.80"];
    "agent_857_state" -> "decision_0" [label="0.70"];
    "agent_858_state" -> "decision_0" [label="0.70"];
    "agent_860_state" -> "decision_0" [label="0.70"];
    "agent_861_state" -> "decision_0" [label="0.70"];
    "agent_862_state" -> "decision_0" [label="0.70"];
    "maneuver_0" -> "maneuver_1" [label="0.90"];
    "maneuver_1" -> "maneuver_2" [label="0.90"];
    "maneuver_2" -> "maneuver_3" [label="0.90"];
    "decision_0" -> "maneuver_0" [label="0.90"];
    "decision_1" -> "maneuver_0" [label="0.80"];
    "decision_2" -> "maneuver_1" [label="0.85"];
    "decision_3" -> "maneuver_3" [label="0.80"];
    "maneuver_0" -> "collision_outcome" [label="0.70"];
    "maneuver_1" -> "collision_outcome" [label="0.80"];
    "maneuver_2" -> "collision_outcome" [label="0.90"];
    "maneuver_3" -> "collision_outcome" [label="0.80"];
    "decision_0" -> "collision_outcome" [label="0.90"];
    "decision_1" -> "collision_outcome" [label="0.80"];
    "decision_2" -> "collision_outcome" [label="0.85"];
    "decision_3" -> "collision_outcome" [label="0.80"];
}