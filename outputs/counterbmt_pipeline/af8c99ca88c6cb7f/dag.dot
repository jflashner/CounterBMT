digraph GroundedDAG {
    rankdir=TB;
    node [shape=box, style=filled];

    // Layer 0: Initial States
    subgraph cluster_0 {
        label="Layer 0: Initial States";
        style=dashed;
        "ego_initial_position" [label="Ego Initial Position\n{'x': 0.0, 'y': 0.0}", fillcolor=skyblue];
        "ego_initial_speed" [label="Ego Initial Speed\n14.889986991882324", fillcolor=skyblue];
        "ego_initial_heading" [label="Ego Initial Heading\n-2.294565200805664", fillcolor=skyblue];
        "agent_23_state" [label="Vehicle agent_23\n{'position': (8452.7", fillcolor=plum];
        "agent_25_state" [label="Vehicle agent_25\n{'position': (8448.9", fillcolor=plum];
        "agent_26_state" [label="Vehicle agent_26\n{'position': (8448.2", fillcolor=plum];
        "agent_27_state" [label="Vehicle agent_27\n{'position': (8451.6", fillcolor=plum];
        "agent_28_state" [label="Vehicle agent_28\n{'position': (8451.8", fillcolor=plum];
    }

    // Layer 1: Events
    subgraph cluster_1 {
        label="Layer 1: Events";
        style=dashed;
        "maneuver_0" [label="Maneuver: lane_change_left\nlane_change_left", fillcolor=turquoise];
        "maneuver_1" [label="Maneuver: straight\nstraight", fillcolor=turquoise];
        "decision_0" [label="Decision: lane_choice\nMaintained lane position", fillcolor=coral];
        "decision_1" [label="Decision: gap_acceptance\nAccepted gap to merge", fillcolor=coral];
        "decision_2" [label="Decision: speed_choice\nMaintained speed", fillcolor=coral];
    }

    // Layer 2: Outcome
    subgraph cluster_2 {
        label="Layer 2: Outcome";
        style=dashed;
        "collision_outcome" [label="Collision Outcome", fillcolor=orange];
    }

    "ego_initial_position" -> "maneuver_0" [label="0.80"];
    "ego_initial_speed" -> "maneuver_0" [label="0.80"];
    "ego_initial_heading" -> "maneuver_0" [label="0.70"];
    "agent_23_state" -> "decision_0" [label="0.90"];
    "agent_25_state" -> "decision_0" [label="0.90"];
    "agent_26_state" -> "decision_0" [label="0.90"];
    "agent_27_state" -> "decision_0" [label="0.90"];
    "agent_28_state" -> "decision_0" [label="0.90"];
    "maneuver_0" -> "maneuver_1" [label="0.80"];
    "maneuver_0" -> "decision_1" [label="0.80"];
    "decision_0" -> "maneuver_1" [label="0.85"];
    "decision_1" -> "maneuver_1" [label="0.85"];
    "decision_2" -> "maneuver_1" [label="0.85"];
    "maneuver_1" -> "collision_outcome" [label="0.90"];
    "decision_0" -> "collision_outcome" [label="0.90"];
    "decision_1" -> "collision_outcome" [label="0.90"];
    "decision_2" -> "collision_outcome" [label="0.90"];
    "maneuver_0" -> "collision_outcome" [label="0.70"];
}