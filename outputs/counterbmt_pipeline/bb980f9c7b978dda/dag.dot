digraph GroundedDAG {
    rankdir=TB;
    node [shape=box, style=filled];

    // Layer 0: Initial States
    subgraph cluster_0 {
        label="Layer 0: Initial States";
        style=dashed;
        "ego_initial_position" [label="Ego Initial Position\n{'x': 0.0, 'y': 0.0}", fillcolor=skyblue];
        "ego_initial_speed" [label="Ego Initial Speed\n4.606210231781006", fillcolor=skyblue];
        "ego_initial_heading" [label="Ego Initial Heading\n1.5854227542877197", fillcolor=skyblue];
        "agent_170_state" [label="Vehicle agent_170\n{'position': (167.45", fillcolor=plum];
        "agent_172_state" [label="Vehicle agent_172\n{'position': (180.50", fillcolor=plum];
        "agent_173_state" [label="Vehicle agent_173\n{'position': (188.80", fillcolor=plum];
        "agent_174_state" [label="Vehicle agent_174\n{'position': (183.96", fillcolor=plum];
        "agent_175_state" [label="Vehicle agent_175\n{'position': (205.58", fillcolor=plum];
    }

    // Layer 1: Events
    subgraph cluster_1 {
        label="Layer 1: Events";
        style=dashed;
        "maneuver_0" [label="Maneuver: straight\nstraight", fillcolor=turquoise];
        "maneuver_1" [label="Maneuver: lane_change_left\nlane_change_left", fillcolor=turquoise];
        "maneuver_2" [label="Maneuver: decelerate\ndecelerate", fillcolor=turquoise];
        "maneuver_3" [label="Maneuver: left_turn\nleft_turn", fillcolor=turquoise];
        "maneuver_4" [label="Maneuver: accelerate\naccelerate", fillcolor=turquoise];
        "decision_0" [label="Decision: proceed_or_yield\nproceed through intersection", fillcolor=coral];
        "decision_1" [label="Decision: lane_choice\nstay in current lane", fillcolor=coral];
        "decision_2" [label="Decision: speed_choice\nmaintain speed", fillcolor=coral];
    }

    // Layer 2: Outcome
    subgraph cluster_2 {
        label="Layer 2: Outcome";
        style=dashed;
        "collision_outcome" [label="Collision Outcome", fillcolor=orange];
    }

    "ego_initial_position" -> "maneuver_0" [label="0.80"];
    "ego_initial_speed" -> "maneuver_0" [label="0.80"];
    "ego_initial_heading" -> "maneuver_0" [label="0.80"];
    "agent_170_state" -> "decision_0" [label="0.70"];
    "agent_172_state" -> "decision_0" [label="0.70"];
    "agent_173_state" -> "decision_0" [label="0.70"];
    "agent_174_state" -> "decision_0" [label="0.70"];
    "agent_175_state" -> "decision_0" [label="0.70"];
    "maneuver_0" -> "maneuver_1" [label="0.60"];
    "maneuver_1" -> "maneuver_2" [label="0.70"];
    "maneuver_2" -> "maneuver_3" [label="0.80"];
    "maneuver_3" -> "maneuver_4" [label="0.80"];
    "decision_0" -> "maneuver_2" [label="0.90"];
    "decision_1" -> "maneuver_3" [label="0.80"];
    "decision_2" -> "maneuver_4" [label="0.85"];
    "maneuver_2" -> "collision_outcome" [label="0.70"];
    "maneuver_3" -> "collision_outcome" [label="0.80"];
    "maneuver_4" -> "collision_outcome" [label="0.70"];
    "maneuver_0" -> "collision_outcome" [label="0.70"];
    "maneuver_1" -> "collision_outcome" [label="0.70"];
    "decision_0" -> "collision_outcome" [label="0.70"];
    "decision_1" -> "collision_outcome" [label="0.70"];
    "decision_2" -> "collision_outcome" [label="0.70"];
}