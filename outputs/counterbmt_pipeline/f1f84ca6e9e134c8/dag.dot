digraph GroundedDAG {
    rankdir=TB;
    node [shape=box, style=filled];

    // Layer 0: Initial States
    subgraph cluster_0 {
        label="Layer 0: Initial States";
        style=dashed;
        "ego_initial_position" [label="Ego Initial Position\n{'x': 0.0, 'y': 0.0}", fillcolor=skyblue];
        "ego_initial_speed" [label="Ego Initial Speed\n26.36920738220215", fillcolor=skyblue];
        "ego_initial_heading" [label="Ego Initial Heading\n-1.5697773694992065", fillcolor=skyblue];
        "agent_2073_state" [label="Pedestrian agent_2073\n{'position': (-353.0", fillcolor=plum];
        "agent_2085_state" [label="Pedestrian agent_2085\n{'position': (-374.5", fillcolor=plum];
        "agent_2087_state" [label="Pedestrian agent_2087\n{'position': (-385.6", fillcolor=plum];
        "agent_1904_state" [label="Vehicle agent_1904\n{'position': (-341.6", fillcolor=plum];
        "agent_1905_state" [label="Vehicle agent_1905\n{'position': (-334.0", fillcolor=plum];
    }

    // Layer 1: Events
    subgraph cluster_1 {
        label="Layer 1: Events";
        style=dashed;
        "maneuver_0" [label="Maneuver: straight\nstraight", fillcolor=turquoise];
        "maneuver_1" [label="Maneuver: lane_change_left\nlane_change_left", fillcolor=turquoise];
        "maneuver_2" [label="Maneuver: straight\nstraight", fillcolor=turquoise];
        "decision_0" [label="Decision: lane_choice\nMaintained lane position", fillcolor=coral];
        "decision_1" [label="Decision: speed_choice\nMaintained speed", fillcolor=coral];
        "decision_2" [label="Decision: evasive_action\nNo evasive action taken", fillcolor=coral];
    }

    // Layer 2: Outcome
    subgraph cluster_2 {
        label="Layer 2: Outcome";
        style=dashed;
        "collision_outcome" [label="Collision Outcome", fillcolor=orange];
    }

    "ego_initial_position" -> "maneuver_0" [label="0.80"];
    "ego_initial_speed" -> "maneuver_0" [label="0.80"];
    "ego_initial_heading" -> "maneuver_0" [label="0.80"];
    "agent_2073_state" -> "decision_0" [label="0.60"];
    "agent_2085_state" -> "decision_0" [label="0.60"];
    "agent_2087_state" -> "decision_0" [label="0.60"];
    "agent_1904_state" -> "decision_0" [label="0.70"];
    "agent_1905_state" -> "decision_0" [label="0.70"];
    "maneuver_0" -> "maneuver_1" [label="0.90"];
    "maneuver_1" -> "maneuver_2" [label="0.90"];
    "decision_0" -> "maneuver_1" [label="0.80"];
    "decision_1" -> "maneuver_2" [label="0.80"];
    "decision_2" -> "maneuver_2" [label="0.80"];
    "maneuver_0" -> "collision_outcome" [label="0.70"];
    "maneuver_1" -> "collision_outcome" [label="0.80"];
    "maneuver_2" -> "collision_outcome" [label="0.80"];
    "decision_0" -> "collision_outcome" [label="0.70"];
    "decision_1" -> "collision_outcome" [label="0.70"];
    "decision_2" -> "collision_outcome" [label="0.70"];
}