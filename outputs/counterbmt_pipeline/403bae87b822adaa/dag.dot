digraph GroundedDAG {
    rankdir=TB;
    node [shape=box, style=filled];

    // Layer 0: Initial States
    subgraph cluster_0 {
        label="Layer 0: Initial States";
        style=dashed;
        "ego_initial_position" [label="Ego Initial Position\n{'x': 0.0, 'y': 0.0}", fillcolor=skyblue];
        "ego_initial_speed" [label="Ego Initial Speed\n14.999783515930176", fillcolor=skyblue];
        "ego_initial_heading" [label="Ego Initial Heading\n-1.5877729654312134", fillcolor=skyblue];
        "agent_2_state" [label="Vehicle agent_2\n{'position': (1662.2", fillcolor=plum];
        "agent_7_state" [label="Vehicle agent_7\n{'position': (1683.8", fillcolor=plum];
        "agent_9_state" [label="Vehicle agent_9\n{'position': (1653.8", fillcolor=plum];
        "agent_10_state" [label="Vehicle agent_10\n{'position': (1683.8", fillcolor=plum];
        "agent_11_state" [label="Vehicle agent_11\n{'position': (1757.2", fillcolor=plum];
    }

    // Layer 1: Events
    subgraph cluster_1 {
        label="Layer 1: Events";
        style=dashed;
        "maneuver_0" [label="Maneuver: straight\nstraight", fillcolor=turquoise];
        "maneuver_1" [label="Maneuver: decelerate\ndecelerate", fillcolor=turquoise];
        "maneuver_2" [label="Maneuver: stop\nstop", fillcolor=turquoise];
        "maneuver_3" [label="Maneuver: accelerate\naccelerate", fillcolor=turquoise];
        "decision_0" [label="Decision: proceed_or_yield\nproceed through intersection", fillcolor=coral];
        "decision_1" [label="Decision: lane_choice\nstay in current lane", fillcolor=coral];
        "decision_2" [label="Decision: speed_choice\nmaintain speed", fillcolor=coral];
        "decision_3" [label="Decision: evasive_action\nno evasive action taken", fillcolor=coral];
    }

    // Layer 2: Outcome
    subgraph cluster_2 {
        label="Layer 2: Outcome";
        style=dashed;
        "collision_outcome" [label="Collision Outcome", fillcolor=orange];
    }

    "ego_initial_position" -> "maneuver_0" [label="0.80"];
    "ego_initial_speed" -> "maneuver_0" [label="0.90"];
    "ego_initial_heading" -> "maneuver_0" [label="0.80"];
    "agent_2_state" -> "decision_0" [label="0.70"];
    "agent_7_state" -> "decision_0" [label="0.70"];
    "agent_9_state" -> "decision_0" [label="0.70"];
    "agent_10_state" -> "decision_0" [label="0.70"];
    "agent_11_state" -> "decision_0" [label="0.80"];
    "decision_0" -> "maneuver_0" [label="0.90"];
    "maneuver_0" -> "maneuver_1" [label="0.80"];
    "maneuver_1" -> "maneuver_2" [label="0.90"];
    "maneuver_2" -> "maneuver_3" [label="0.90"];
    "decision_1" -> "maneuver_1" [label="0.80"];
    "decision_2" -> "maneuver_2" [label="0.90"];
    "decision_3" -> "maneuver_3" [label="0.95"];
    "maneuver_0" -> "collision_outcome" [label="0.70"];
    "maneuver_1" -> "collision_outcome" [label="0.80"];
    "maneuver_2" -> "collision_outcome" [label="0.90"];
    "maneuver_3" -> "collision_outcome" [label="0.80"];
    "decision_0" -> "collision_outcome" [label="0.70"];
    "decision_1" -> "collision_outcome" [label="0.70"];
    "decision_2" -> "collision_outcome" [label="0.70"];
    "decision_3" -> "collision_outcome" [label="0.70"];
}