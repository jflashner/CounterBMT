digraph GroundedDAG {
    rankdir=TB;
    node [shape=box, style=filled];

    // Layer 0: Initial States
    subgraph cluster_0 {
        label="Layer 0: Initial States";
        style=dashed;
        "ego_initial_position" [label="Ego Initial Position\n{'x': 0.0, 'y': 0.0}", fillcolor=skyblue];
        "ego_initial_speed" [label="Ego Initial Speed\n2.8091437816619873", fillcolor=skyblue];
        "ego_initial_heading" [label="Ego Initial Heading\n-2.116783857345581", fillcolor=skyblue];
        "agent_1092_state" [label="Vehicle agent_1092\n{'position': (2166.4", fillcolor=plum];
        "agent_1093_state" [label="Vehicle agent_1093\n{'position': (2192.0", fillcolor=plum];
        "agent_1094_state" [label="Vehicle agent_1094\n{'position': (2166.6", fillcolor=plum];
        "agent_1095_state" [label="Vehicle agent_1095\n{'position': (2169.9", fillcolor=plum];
        "agent_1096_state" [label="Vehicle agent_1096\n{'position': (2172.7", fillcolor=plum];
    }

    // Layer 1: Events
    subgraph cluster_1 {
        label="Layer 1: Events";
        style=dashed;
        "maneuver_0" [label="Maneuver: straight\nstraight", fillcolor=turquoise];
        "maneuver_1" [label="Maneuver: right_turn\nright_turn", fillcolor=turquoise];
        "maneuver_2" [label="Maneuver: straight\nstraight", fillcolor=turquoise];
        "decision_0" [label="Decision: proceed_or_yield\nproceed through intersection", fillcolor=coral];
        "decision_1" [label="Decision: lane_choice\nstay in current lane", fillcolor=coral];
        "decision_2" [label="Decision: speed_choice\nmaintain speed", fillcolor=coral];
    }

    // Layer 2: Outcome
    subgraph cluster_2 {
        label="Layer 2: Outcome";
        style=dashed;
        "collision_outcome" [label="Collision Outcome", fillcolor=orange];
    }

    "ego_initial_position" -> "maneuver_0" [label="0.80"];
    "ego_initial_speed" -> "maneuver_0" [label="0.80"];
    "ego_initial_heading" -> "maneuver_0" [label="0.80"];
    "agent_1092_state" -> "decision_0" [label="0.70"];
    "agent_1093_state" -> "decision_0" [label="0.70"];
    "agent_1094_state" -> "decision_0" [label="0.70"];
    "agent_1095_state" -> "decision_0" [label="0.70"];
    "agent_1096_state" -> "decision_0" [label="0.70"];
    "maneuver_0" -> "maneuver_1" [label="0.90"];
    "maneuver_1" -> "maneuver_2" [label="0.90"];
    "decision_0" -> "maneuver_1" [label="0.80"];
    "decision_1" -> "maneuver_2" [label="0.80"];
    "decision_2" -> "maneuver_2" [label="0.80"];
    "maneuver_0" -> "collision_outcome" [label="0.60"];
    "maneuver_1" -> "collision_outcome" [label="0.70"];
    "maneuver_2" -> "collision_outcome" [label="0.70"];
    "decision_0" -> "collision_outcome" [label="0.80"];
    "decision_1" -> "collision_outcome" [label="0.70"];
    "decision_2" -> "collision_outcome" [label="0.70"];
}