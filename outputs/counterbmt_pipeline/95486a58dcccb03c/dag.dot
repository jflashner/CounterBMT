digraph GroundedDAG {
    rankdir=TB;
    node [shape=box, style=filled];

    // Layer 0: Initial States
    subgraph cluster_0 {
        label="Layer 0: Initial States";
        style=dashed;
        "ego_initial_position" [label="Ego Initial Position\n{'x': 0.0, 'y': 0.0}", fillcolor=skyblue];
        "ego_initial_speed" [label="Ego Initial Speed\n11.701993942260742", fillcolor=skyblue];
        "ego_initial_heading" [label="Ego Initial Heading\n-1.5240892171859741", fillcolor=skyblue];
        "agent_769_state" [label="Vehicle agent_769\n{'position': (253.34", fillcolor=plum];
        "agent_770_state" [label="Vehicle agent_770\n{'position': (270.05", fillcolor=plum];
        "agent_787_state" [label="Vehicle agent_787\n{'position': (322.42", fillcolor=plum];
        "agent_790_state" [label="Vehicle agent_790\n{'position': (268.53", fillcolor=plum];
        "agent_794_state" [label="Vehicle agent_794\n{'position': (281.38", fillcolor=plum];
    }

    // Layer 1: Events
    subgraph cluster_1 {
        label="Layer 1: Events";
        style=dashed;
        "maneuver_0" [label="Maneuver: straight\nstraight", fillcolor=turquoise];
        "maneuver_1" [label="Maneuver: decelerate\ndecelerate", fillcolor=turquoise];
        "maneuver_2" [label="Maneuver: stop\nstop", fillcolor=turquoise];
        "maneuver_3" [label="Maneuver: accelerate\naccelerate", fillcolor=turquoise];
        "decision_0" [label="Decision: proceed_or_yield\nproceeded through the intersection", fillcolor=coral];
        "decision_1" [label="Decision: lane_choice\nremained in the current lane", fillcolor=coral];
        "decision_2" [label="Decision: gap_acceptance\naccepted the gap to merge", fillcolor=coral];
    }

    // Layer 2: Outcome
    subgraph cluster_2 {
        label="Layer 2: Outcome";
        style=dashed;
        "collision_outcome" [label="Collision Outcome", fillcolor=orange];
    }

    "ego_initial_position" -> "maneuver_0" [label="0.80"];
    "ego_initial_speed" -> "maneuver_0" [label="0.80"];
    "ego_initial_heading" -> "maneuver_0" [label="0.80"];
    "agent_769_state" -> "decision_0" [label="0.70"];
    "agent_770_state" -> "decision_0" [label="0.70"];
    "agent_787_state" -> "decision_0" [label="0.70"];
    "agent_790_state" -> "decision_0" [label="0.70"];
    "agent_794_state" -> "decision_0" [label="0.70"];
    "maneuver_0" -> "maneuver_1" [label="0.90"];
    "maneuver_1" -> "maneuver_2" [label="0.90"];
    "maneuver_2" -> "maneuver_3" [label="0.90"];
    "decision_0" -> "maneuver_1" [label="0.80"];
    "decision_1" -> "maneuver_2" [label="0.80"];
    "decision_2" -> "maneuver_3" [label="0.90"];
    "maneuver_1" -> "collision_outcome" [label="0.70"];
    "maneuver_2" -> "collision_outcome" [label="0.70"];
    "maneuver_3" -> "collision_outcome" [label="0.70"];
    "decision_0" -> "collision_outcome" [label="0.80"];
    "decision_1" -> "collision_outcome" [label="0.70"];
    "decision_2" -> "collision_outcome" [label="0.90"];
    "maneuver_0" -> "collision_outcome" [label="0.70"];
}