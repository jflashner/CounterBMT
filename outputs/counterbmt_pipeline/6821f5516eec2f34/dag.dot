digraph GroundedDAG {
    rankdir=TB;
    node [shape=box, style=filled];

    // Layer 0: Initial States
    subgraph cluster_0 {
        label="Layer 0: Initial States";
        style=dashed;
        "ego_initial_position" [label="Ego Initial Position\n{'x': 0.0, 'y': 0.0}", fillcolor=skyblue];
        "ego_initial_speed" [label="Ego Initial Speed\n20.155492782592773", fillcolor=skyblue];
        "ego_initial_heading" [label="Ego Initial Heading\n-3.1174628734588623", fillcolor=skyblue];
        "agent_769_state" [label="Vehicle agent_769\n{'position': (8393.9", fillcolor=plum];
        "agent_770_state" [label="Vehicle agent_770\n{'position': (8397.8", fillcolor=plum];
        "agent_771_state" [label="Vehicle agent_771\n{'position': (8451.2", fillcolor=plum];
        "agent_772_state" [label="Vehicle agent_772\n{'position': (8465.4", fillcolor=plum];
        "agent_773_state" [label="Vehicle agent_773\n{'position': (8401.5", fillcolor=plum];
    }

    // Layer 1: Events
    subgraph cluster_1 {
        label="Layer 1: Events";
        style=dashed;
        "maneuver_0" [label="Maneuver: straight\nstraight", fillcolor=turquoise];
        "maneuver_1" [label="Maneuver: lane_change_left\nlane_change_left", fillcolor=turquoise];
        "maneuver_2" [label="Maneuver: straight\nstraight", fillcolor=turquoise];
        "decision_0" [label="Decision: proceed_or_yield\nproceed through intersection", fillcolor=coral];
        "decision_1" [label="Decision: lane_choice\nmaintain current lane", fillcolor=coral];
        "decision_2" [label="Decision: speed_choice\nmaintain speed", fillcolor=coral];
    }

    // Layer 2: Outcome
    subgraph cluster_2 {
        label="Layer 2: Outcome";
        style=dashed;
        "collision_outcome" [label="Collision Outcome", fillcolor=orange];
    }

    "ego_initial_position" -> "maneuver_0" [label="0.80"];
    "ego_initial_speed" -> "maneuver_0" [label="0.90"];
    "ego_initial_heading" -> "maneuver_0" [label="0.80"];
    "agent_769_state" -> "decision_0" [label="0.70"];
    "agent_770_state" -> "decision_0" [label="0.70"];
    "agent_771_state" -> "decision_0" [label="0.70"];
    "agent_772_state" -> "decision_0" [label="0.70"];
    "agent_773_state" -> "decision_0" [label="0.70"];
    "decision_0" -> "maneuver_0" [label="0.90"];
    "maneuver_0" -> "maneuver_1" [label="0.80"];
    "maneuver_1" -> "maneuver_2" [label="0.80"];
    "decision_1" -> "maneuver_1" [label="0.80"];
    "decision_2" -> "maneuver_2" [label="0.90"];
    "maneuver_0" -> "collision_outcome" [label="0.70"];
    "maneuver_1" -> "collision_outcome" [label="0.70"];
    "maneuver_2" -> "collision_outcome" [label="0.70"];
    "decision_0" -> "collision_outcome" [label="0.80"];
    "decision_1" -> "collision_outcome" [label="0.80"];
    "decision_2" -> "collision_outcome" [label="0.80"];
}