digraph GroundedDAG {
    rankdir=TB;
    node [shape=box, style=filled];

    // Layer 0: Initial States
    subgraph cluster_0 {
        label="Layer 0: Initial States";
        style=dashed;
        "ego_initial_position" [label="Ego Initial Position\n{'x': 0.0, 'y': 0.0}", fillcolor=skyblue];
        "ego_initial_speed" [label="Ego Initial Speed\n10.374009132385254", fillcolor=skyblue];
        "ego_initial_heading" [label="Ego Initial Heading\n3.071303367614746", fillcolor=skyblue];
        "agent_642_state" [label="Vehicle agent_642\n{'position': (-3670.", fillcolor=plum];
        "agent_647_state" [label="Vehicle agent_647\n{'position': (-3676.", fillcolor=plum];
        "agent_650_state" [label="Vehicle agent_650\n{'position': (-3675.", fillcolor=plum];
        "agent_651_state" [label="Vehicle agent_651\n{'position': (-3663.", fillcolor=plum];
        "agent_620_state" [label="Vehicle agent_620\n{'position': (-3712.", fillcolor=plum];
    }

    // Layer 1: Events
    subgraph cluster_1 {
        label="Layer 1: Events";
        style=dashed;
        "maneuver_0" [label="Maneuver: straight\nstraight", fillcolor=turquoise];
        "maneuver_1" [label="Maneuver: decelerate\ndecelerate", fillcolor=turquoise];
        "maneuver_2" [label="Maneuver: stop\nstop", fillcolor=turquoise];
        "maneuver_3" [label="Maneuver: straight\nstraight", fillcolor=turquoise];
        "decision_0" [label="Decision: proceed_or_yield\nproceed through intersection", fillcolor=coral];
        "decision_1" [label="Decision: lane_choice\nstay in current lane", fillcolor=coral];
        "decision_2" [label="Decision: gap_acceptance\naccept gap and merge", fillcolor=coral];
    }

    // Layer 2: Outcome
    subgraph cluster_2 {
        label="Layer 2: Outcome";
        style=dashed;
        "collision_outcome" [label="Collision Outcome", fillcolor=orange];
    }

    "ego_initial_position" -> "maneuver_0" [label="0.80"];
    "ego_initial_speed" -> "maneuver_0" [label="0.90"];
    "ego_initial_heading" -> "maneuver_0" [label="0.80"];
    "agent_620_state" -> "decision_0" [label="0.85"];
    "agent_642_state" -> "decision_0" [label="0.70"];
    "agent_647_state" -> "decision_1" [label="0.75"];
    "agent_650_state" -> "decision_1" [label="0.75"];
    "agent_651_state" -> "decision_1" [label="0.75"];
    "maneuver_0" -> "maneuver_1" [label="0.80"];
    "maneuver_1" -> "maneuver_2" [label="0.90"];
    "maneuver_2" -> "maneuver_3" [label="0.90"];
    "decision_0" -> "maneuver_1" [label="0.85"];
    "decision_1" -> "maneuver_2" [label="0.90"];
    "decision_2" -> "maneuver_3" [label="0.80"];
    "maneuver_0" -> "collision_outcome" [label="0.70"];
    "maneuver_1" -> "collision_outcome" [label="0.80"];
    "maneuver_2" -> "collision_outcome" [label="0.90"];
    "maneuver_3" -> "collision_outcome" [label="0.80"];
    "decision_0" -> "collision_outcome" [label="0.85"];
    "decision_1" -> "collision_outcome" [label="0.90"];
    "decision_2" -> "collision_outcome" [label="0.80"];
}