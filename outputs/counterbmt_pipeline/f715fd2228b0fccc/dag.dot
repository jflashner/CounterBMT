digraph GroundedDAG {
    rankdir=TB;
    node [shape=box, style=filled];

    // Layer 0: Initial States
    subgraph cluster_0 {
        label="Layer 0: Initial States";
        style=dashed;
        "ego_initial_position" [label="Ego Initial Position\n{'x': 0.0, 'y': 0.0}", fillcolor=skyblue];
        "ego_initial_speed" [label="Ego Initial Speed\n2.7903788089752197", fillcolor=skyblue];
        "ego_initial_heading" [label="Ego Initial Heading\n1.120330572128296", fillcolor=skyblue];
        "agent_1290_state" [label="Pedestrian agent_1290\n{'position': (-4842.", fillcolor=plum];
        "agent_1291_state" [label="Pedestrian agent_1291\n{'position': (-4843.", fillcolor=plum];
        "agent_1292_state" [label="Pedestrian agent_1292\n{'position': (-4853.", fillcolor=plum];
        "agent_1293_state" [label="Pedestrian agent_1293\n{'position': (-4848.", fillcolor=plum];
        "agent_1294_state" [label="Pedestrian agent_1294\n{'position': (-4850.", fillcolor=plum];
    }

    // Layer 1: Events
    subgraph cluster_1 {
        label="Layer 1: Events";
        style=dashed;
        "maneuver_0" [label="Maneuver: straight\nstraight", fillcolor=turquoise];
        "maneuver_1" [label="Maneuver: decelerate\ndecelerate", fillcolor=turquoise];
        "maneuver_2" [label="Maneuver: stop\nstop", fillcolor=turquoise];
        "maneuver_3" [label="Maneuver: accelerate\naccelerate", fillcolor=turquoise];
        "decision_0" [label="Decision: proceed_or_yield\nproceed through intersection", fillcolor=coral];
        "decision_1" [label="Decision: lane_choice\nstay in current lane", fillcolor=coral];
        "decision_2" [label="Decision: speed_choice\nmaintain speed", fillcolor=coral];
    }

    // Layer 2: Outcome
    subgraph cluster_2 {
        label="Layer 2: Outcome";
        style=dashed;
        "collision_outcome" [label="Collision Outcome", fillcolor=orange];
    }

    "ego_initial_position" -> "maneuver_0" [label="0.80"];
    "ego_initial_speed" -> "maneuver_0" [label="0.80"];
    "ego_initial_heading" -> "maneuver_0" [label="0.80"];
    "agent_1290_state" -> "decision_0" [label="0.70"];
    "agent_1291_state" -> "decision_0" [label="0.70"];
    "agent_1292_state" -> "decision_0" [label="0.70"];
    "agent_1293_state" -> "decision_0" [label="0.70"];
    "agent_1294_state" -> "decision_0" [label="0.70"];
    "maneuver_0" -> "maneuver_1" [label="0.90"];
    "maneuver_1" -> "maneuver_2" [label="0.90"];
    "maneuver_2" -> "maneuver_3" [label="0.90"];
    "decision_0" -> "maneuver_1" [label="0.80"];
    "decision_1" -> "maneuver_2" [label="0.80"];
    "decision_2" -> "maneuver_3" [label="0.80"];
    "maneuver_0" -> "collision_outcome" [label="0.70"];
    "maneuver_1" -> "collision_outcome" [label="0.70"];
    "maneuver_2" -> "collision_outcome" [label="0.70"];
    "maneuver_3" -> "collision_outcome" [label="0.70"];
    "decision_0" -> "collision_outcome" [label="0.80"];
    "decision_1" -> "collision_outcome" [label="0.80"];
    "decision_2" -> "collision_outcome" [label="0.80"];
}