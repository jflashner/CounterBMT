digraph GroundedDAG {
    rankdir=TB;
    node [shape=box, style=filled];

    // Layer 0: Initial States
    subgraph cluster_0 {
        label="Layer 0: Initial States";
        style=dashed;
        "ego_initial_position" [label="Ego Initial Position\n{'x': 0.0, 'y': 0.0}", fillcolor=skyblue];
        "ego_initial_speed" [label="Ego Initial Speed\n0.001951919402927160", fillcolor=skyblue];
        "ego_initial_heading" [label="Ego Initial Heading\n-2.170875072479248", fillcolor=skyblue];
        "agent_5147_state" [label="Pedestrian agent_5147\n{'position': (-3480.", fillcolor=plum];
        "agent_5148_state" [label="Pedestrian agent_5148\n{'position': (-3501.", fillcolor=plum];
        "agent_5155_state" [label="Pedestrian agent_5155\n{'position': (-3436.", fillcolor=plum];
        "agent_1261_state" [label="Vehicle agent_1261\n{'position': (-3455.", fillcolor=plum];
        "agent_1262_state" [label="Vehicle agent_1262\n{'position': (-3465.", fillcolor=plum];
    }

    // Layer 1: Events
    subgraph cluster_1 {
        label="Layer 1: Events";
        style=dashed;
        "maneuver_0" [label="Maneuver: straight\nstraight", fillcolor=turquoise];
        "maneuver_1" [label="Maneuver: decelerate\ndecelerate", fillcolor=turquoise];
        "maneuver_2" [label="Maneuver: stop\nstop", fillcolor=turquoise];
        "maneuver_3" [label="Maneuver: left_turn\nleft_turn", fillcolor=turquoise];
        "maneuver_4" [label="Maneuver: accelerate\naccelerate", fillcolor=turquoise];
        "decision_0" [label="Decision: proceed_or_yield\nproceed through intersection", fillcolor=coral];
        "decision_1" [label="Decision: lane_choice\nstay in current lane", fillcolor=coral];
        "decision_2" [label="Decision: speed_choice\nmaintain speed", fillcolor=coral];
        "decision_3" [label="Decision: gap_acceptance\naccept gap and merge", fillcolor=coral];
    }

    // Layer 2: Outcome
    subgraph cluster_2 {
        label="Layer 2: Outcome";
        style=dashed;
        "collision_outcome" [label="Collision Outcome", fillcolor=orange];
    }

    "ego_initial_position" -> "maneuver_0" [label="0.80"];
    "ego_initial_speed" -> "maneuver_0" [label="0.80"];
    "ego_initial_heading" -> "maneuver_0" [label="0.80"];
    "agent_5147_state" -> "decision_0" [label="0.70"];
    "agent_5148_state" -> "decision_0" [label="0.70"];
    "agent_5155_state" -> "decision_0" [label="0.70"];
    "agent_1261_state" -> "decision_0" [label="0.80"];
    "agent_1262_state" -> "decision_0" [label="0.80"];
    "maneuver_0" -> "maneuver_1" [label="0.90"];
    "maneuver_1" -> "maneuver_2" [label="0.90"];
    "maneuver_2" -> "maneuver_3" [label="0.90"];
    "maneuver_3" -> "maneuver_4" [label="0.90"];
    "decision_0" -> "maneuver_1" [label="0.90"];
    "decision_1" -> "maneuver_2" [label="0.80"];
    "decision_2" -> "maneuver_3" [label="0.85"];
    "decision_3" -> "maneuver_4" [label="0.90"];
    "maneuver_1" -> "collision_outcome" [label="0.70"];
    "maneuver_2" -> "collision_outcome" [label="0.80"];
    "maneuver_3" -> "collision_outcome" [label="0.80"];
    "maneuver_4" -> "collision_outcome" [label="0.70"];
    "decision_0" -> "collision_outcome" [label="0.90"];
    "decision_1" -> "collision_outcome" [label="0.80"];
    "decision_2" -> "collision_outcome" [label="0.85"];
    "decision_3" -> "collision_outcome" [label="0.90"];
    "maneuver_0" -> "collision_outcome" [label="0.70"];
}