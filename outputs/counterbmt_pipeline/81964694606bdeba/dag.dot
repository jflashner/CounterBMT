digraph GroundedDAG {
    rankdir=TB;
    node [shape=box, style=filled];

    // Layer 0: Initial States
    subgraph cluster_0 {
        label="Layer 0: Initial States";
        style=dashed;
        "ego_initial_position" [label="Ego Initial Position\n{'x': 0.0, 'y': 0.0}", fillcolor=skyblue];
        "ego_initial_speed" [label="Ego Initial Speed\n0.000557489111088216", fillcolor=skyblue];
        "ego_initial_heading" [label="Ego Initial Heading\n-0.5480910539627075", fillcolor=skyblue];
        "agent_2186_state" [label="Vehicle agent_2186\n{'position': (1050.2", fillcolor=plum];
        "agent_2187_state" [label="Vehicle agent_2187\n{'position': (1051.1", fillcolor=plum];
        "agent_2188_state" [label="Vehicle agent_2188\n{'position': (1033.5", fillcolor=plum];
        "agent_2191_state" [label="Vehicle agent_2191\n{'position': (1034.7", fillcolor=plum];
        "agent_2192_state" [label="Vehicle agent_2192\n{'position': (1026.7", fillcolor=plum];
    }

    // Layer 1: Events
    subgraph cluster_1 {
        label="Layer 1: Events";
        style=dashed;
        "maneuver_0" [label="Maneuver: stop\nstop", fillcolor=turquoise];
        "maneuver_1" [label="Maneuver: accelerate\naccelerate", fillcolor=turquoise];
        "maneuver_2" [label="Maneuver: lane_change_left\nlane_change_left", fillcolor=turquoise];
        "maneuver_3" [label="Maneuver: straight\nstraight", fillcolor=turquoise];
        "maneuver_4" [label="Maneuver: lane_change_right\nlane_change_right", fillcolor=turquoise];
        "maneuver_5" [label="Maneuver: decelerate\ndecelerate", fillcolor=turquoise];
        "maneuver_6" [label="Maneuver: stop\nstop", fillcolor=turquoise];
        "decision_0" [label="Decision: proceed_or_yield\nproceed", fillcolor=coral];
        "decision_1" [label="Decision: lane_choice\nstay in lane", fillcolor=coral];
        "decision_2" [label="Decision: speed_choice\nmaintain speed", fillcolor=coral];
        "decision_3" [label="Decision: evasive_action\nno evasive action", fillcolor=coral];
    }

    // Layer 2: Outcome
    subgraph cluster_2 {
        label="Layer 2: Outcome";
        style=dashed;
        "collision_outcome" [label="Collision Outcome", fillcolor=orange];
    }

    "ego_initial_position" -> "maneuver_0" [label="0.80"];
    "ego_initial_speed" -> "maneuver_0" [label="0.80"];
    "ego_initial_heading" -> "maneuver_0" [label="0.80"];
    "agent_2186_state" -> "maneuver_5" [label="0.70"];
    "agent_2187_state" -> "maneuver_5" [label="0.70"];
    "agent_2188_state" -> "maneuver_5" [label="0.70"];
    "agent_2191_state" -> "maneuver_5" [label="0.70"];
    "agent_2192_state" -> "maneuver_5" [label="0.70"];
    "maneuver_0" -> "maneuver_1" [label="0.90"];
    "maneuver_1" -> "decision_0" [label="0.90"];
    "decision_0" -> "maneuver_2" [label="0.80"];
    "maneuver_2" -> "decision_1" [label="0.80"];
    "decision_1" -> "maneuver_3" [label="0.80"];
    "maneuver_3" -> "maneuver_4" [label="0.80"];
    "maneuver_4" -> "decision_2" [label="0.80"];
    "decision_2" -> "maneuver_5" [label="0.85"];
    "maneuver_5" -> "maneuver_6" [label="0.90"];
    "maneuver_6" -> "decision_3" [label="0.90"];
    "maneuver_0" -> "collision_outcome" [label="0.70"];
    "maneuver_1" -> "collision_outcome" [label="0.70"];
    "maneuver_2" -> "collision_outcome" [label="0.70"];
    "maneuver_3" -> "collision_outcome" [label="0.70"];
    "maneuver_4" -> "collision_outcome" [label="0.70"];
    "maneuver_5" -> "collision_outcome" [label="0.70"];
    "maneuver_6" -> "collision_outcome" [label="0.70"];
    "decision_0" -> "collision_outcome" [label="0.70"];
    "decision_1" -> "collision_outcome" [label="0.70"];
    "decision_2" -> "collision_outcome" [label="0.70"];
    "decision_3" -> "collision_outcome" [label="0.70"];
}