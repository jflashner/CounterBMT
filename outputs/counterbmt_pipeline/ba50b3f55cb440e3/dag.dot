digraph GroundedDAG {
    rankdir=TB;
    node [shape=box, style=filled];

    // Layer 0: Initial States
    subgraph cluster_0 {
        label="Layer 0: Initial States";
        style=dashed;
        "ego_initial_position" [label="Ego Initial Position\n{'x': 0.0, 'y': 0.0}", fillcolor=skyblue];
        "ego_initial_speed" [label="Ego Initial Speed\n0.001370135578326881", fillcolor=skyblue];
        "ego_initial_heading" [label="Ego Initial Heading\n-0.00392976030707359", fillcolor=skyblue];
        "agent_410_state" [label="Vehicle agent_410\n{'position': (477.69", fillcolor=plum];
        "agent_411_state" [label="Vehicle agent_411\n{'position': (470.50", fillcolor=plum];
        "agent_412_state" [label="Vehicle agent_412\n{'position': (458.54", fillcolor=plum];
        "agent_413_state" [label="Vehicle agent_413\n{'position': (477.53", fillcolor=plum];
        "agent_414_state" [label="Vehicle agent_414\n{'position': (487.84", fillcolor=plum];
    }

    // Layer 1: Events
    subgraph cluster_1 {
        label="Layer 1: Events";
        style=dashed;
        "maneuver_0" [label="Maneuver: decelerate\ndecelerate", fillcolor=turquoise];
        "maneuver_1" [label="Maneuver: stop\nstop", fillcolor=turquoise];
        "maneuver_2" [label="Maneuver: accelerate\naccelerate", fillcolor=turquoise];
        "decision_0" [label="Decision: proceed_or_yield\nproceed through intersection", fillcolor=coral];
        "decision_1" [label="Decision: lane_choice\nstay in current lane", fillcolor=coral];
        "decision_2" [label="Decision: speed_choice\nmaintain speed", fillcolor=coral];
        "decision_3" [label="Decision: gap_acceptance\nwait for larger gap", fillcolor=coral];
    }

    // Layer 2: Outcome
    subgraph cluster_2 {
        label="Layer 2: Outcome";
        style=dashed;
        "collision_outcome" [label="Collision Outcome", fillcolor=orange];
    }

    "ego_initial_position" -> "maneuver_0" [label="0.80"];
    "ego_initial_speed" -> "maneuver_0" [label="0.90"];
    "ego_initial_heading" -> "maneuver_0" [label="0.70"];
    "agent_410_state" -> "decision_0" [label="0.85"];
    "agent_411_state" -> "decision_0" [label="0.85"];
    "agent_412_state" -> "decision_0" [label="0.85"];
    "agent_413_state" -> "decision_0" [label="0.85"];
    "agent_414_state" -> "decision_0" [label="0.90"];
    "maneuver_0" -> "maneuver_1" [label="0.95"];
    "maneuver_1" -> "maneuver_2" [label="0.95"];
    "decision_0" -> "maneuver_0" [label="0.90"];
    "decision_1" -> "maneuver_1" [label="0.80"];
    "decision_2" -> "maneuver_2" [label="0.85"];
    "decision_3" -> "maneuver_2" [label="0.90"];
    "maneuver_0" -> "collision_outcome" [label="0.70"];
    "maneuver_1" -> "collision_outcome" [label="0.80"];
    "maneuver_2" -> "collision_outcome" [label="0.75"];
    "decision_0" -> "collision_outcome" [label="0.80"];
    "decision_1" -> "collision_outcome" [label="0.70"];
    "decision_2" -> "collision_outcome" [label="0.75"];
    "decision_3" -> "collision_outcome" [label="0.85"];
}