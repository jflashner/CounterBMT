digraph GroundedDAG {
    rankdir=TB;
    node [shape=box, style=filled];

    // Layer 0: Initial States
    subgraph cluster_0 {
        label="Layer 0: Initial States";
        style=dashed;
        "ego_initial_position" [label="Ego Initial Position\n{'x': 0.0, 'y': 0.0}", fillcolor=skyblue];
        "ego_initial_speed" [label="Ego Initial Speed\n15.159846305847168", fillcolor=skyblue];
        "ego_initial_heading" [label="Ego Initial Heading\n1.5701252222061157", fillcolor=skyblue];
        "agent_2574_state" [label="Vehicle agent_2574\n{'position': (2766.4", fillcolor=plum];
        "agent_2576_state" [label="Vehicle agent_2576\n{'position': (2773.4", fillcolor=plum];
        "agent_2577_state" [label="Vehicle agent_2577\n{'position': (2763.1", fillcolor=plum];
        "agent_2579_state" [label="Vehicle agent_2579\n{'position': (2758.9", fillcolor=plum];
        "agent_2580_state" [label="Vehicle agent_2580\n{'position': (2764.1", fillcolor=plum];
    }

    // Layer 1: Events
    subgraph cluster_1 {
        label="Layer 1: Events";
        style=dashed;
        "maneuver_0" [label="Maneuver: straight\nstraight", fillcolor=turquoise];
        "maneuver_1" [label="Maneuver: decelerate\ndecelerate", fillcolor=turquoise];
        "maneuver_2" [label="Maneuver: stop\nstop", fillcolor=turquoise];
        "maneuver_3" [label="Maneuver: accelerate\naccelerate", fillcolor=turquoise];
        "maneuver_4" [label="Maneuver: lane_change_left\nlane_change_left", fillcolor=turquoise];
        "maneuver_5" [label="Maneuver: straight\nstraight", fillcolor=turquoise];
        "decision_0" [label="Decision: proceed_or_yield\nproceed through intersection", fillcolor=coral];
        "decision_1" [label="Decision: lane_choice\nstay in current lane", fillcolor=coral];
        "decision_2" [label="Decision: evasive_action\nmaintain speed and lane", fillcolor=coral];
    }

    // Layer 2: Outcome
    subgraph cluster_2 {
        label="Layer 2: Outcome";
        style=dashed;
        "collision_outcome" [label="Collision Outcome", fillcolor=orange];
    }

    "ego_initial_position" -> "maneuver_0" [label="0.80"];
    "ego_initial_speed" -> "maneuver_0" [label="0.80"];
    "ego_initial_heading" -> "maneuver_0" [label="0.80"];
    "agent_2574_state" -> "decision_0" [label="0.70"];
    "agent_2576_state" -> "decision_0" [label="0.70"];
    "agent_2577_state" -> "decision_0" [label="0.70"];
    "agent_2579_state" -> "decision_0" [label="0.70"];
    "agent_2580_state" -> "decision_0" [label="0.70"];
    "maneuver_0" -> "maneuver_1" [label="0.90"];
    "maneuver_1" -> "maneuver_2" [label="0.90"];
    "maneuver_2" -> "maneuver_3" [label="0.90"];
    "maneuver_3" -> "maneuver_4" [label="0.80"];
    "maneuver_4" -> "maneuver_5" [label="0.80"];
    "decision_0" -> "maneuver_2" [label="0.80"];
    "decision_1" -> "maneuver_4" [label="0.90"];
    "decision_2" -> "maneuver_5" [label="0.85"];
    "maneuver_5" -> "collision_outcome" [label="0.80"];
    "decision_0" -> "collision_outcome" [label="0.80"];
    "decision_1" -> "collision_outcome" [label="0.90"];
    "decision_2" -> "collision_outcome" [label="0.85"];
    "maneuver_0" -> "collision_outcome" [label="0.70"];
    "maneuver_1" -> "collision_outcome" [label="0.70"];
    "maneuver_2" -> "collision_outcome" [label="0.70"];
    "maneuver_3" -> "collision_outcome" [label="0.70"];
    "maneuver_4" -> "collision_outcome" [label="0.70"];
}