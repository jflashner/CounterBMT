digraph GroundedDAG {
    rankdir=TB;
    node [shape=box, style=filled];

    // Layer 0: Initial States
    subgraph cluster_0 {
        label="Layer 0: Initial States";
        style=dashed;
        "ego_initial_position" [label="Ego Initial Position\n{'x': 0.0, 'y': 0.0}", fillcolor=skyblue];
        "ego_initial_speed" [label="Ego Initial Speed\n0.05230579897761345", fillcolor=skyblue];
        "ego_initial_heading" [label="Ego Initial Heading\n3.135549545288086", fillcolor=skyblue];
        "agent_2452_state" [label="Vehicle agent_2452\n{'position': (10015.", fillcolor=plum];
        "agent_3349_state" [label="Pedestrian agent_3349\n{'position': (10004.", fillcolor=plum];
        "agent_2453_state" [label="Vehicle agent_2453\n{'position': (10019.", fillcolor=plum];
        "agent_2457_state" [label="Vehicle agent_2457\n{'position': (10010.", fillcolor=plum];
        "agent_2460_state" [label="Vehicle agent_2460\n{'position': (10016.", fillcolor=plum];
    }

    // Layer 1: Events
    subgraph cluster_1 {
        label="Layer 1: Events";
        style=dashed;
        "maneuver_0" [label="Maneuver: straight\nstraight", fillcolor=turquoise];
        "maneuver_1" [label="Maneuver: decelerate\ndecelerate", fillcolor=turquoise];
        "maneuver_2" [label="Maneuver: stop\nstop", fillcolor=turquoise];
        "maneuver_3" [label="Maneuver: accelerate\naccelerate", fillcolor=turquoise];
        "decision_0" [label="Decision: proceed_or_yield\nproceed through intersection", fillcolor=coral];
        "decision_1" [label="Decision: lane_choice\nstay in current lane", fillcolor=coral];
        "decision_2" [label="Decision: evasive_action\nmaintain speed", fillcolor=coral];
        "decision_3" [label="Decision: gap_acceptance\naccept gap to merge", fillcolor=coral];
    }

    // Layer 2: Outcome
    subgraph cluster_2 {
        label="Layer 2: Outcome";
        style=dashed;
        "collision_outcome" [label="Collision Outcome", fillcolor=orange];
    }

    "ego_initial_position" -> "maneuver_0" [label="0.80"];
    "ego_initial_speed" -> "maneuver_0" [label="0.80"];
    "ego_initial_heading" -> "maneuver_0" [label="0.80"];
    "agent_2452_state" -> "decision_0" [label="0.70"];
    "agent_3349_state" -> "decision_0" [label="0.70"];
    "agent_2453_state" -> "decision_0" [label="0.70"];
    "agent_2457_state" -> "decision_0" [label="0.70"];
    "agent_2460_state" -> "decision_0" [label="0.70"];
    "decision_0" -> "maneuver_0" [label="0.90"];
    "maneuver_0" -> "maneuver_1" [label="0.80"];
    "maneuver_1" -> "maneuver_2" [label="0.90"];
    "maneuver_2" -> "maneuver_3" [label="0.90"];
    "maneuver_1" -> "decision_1" [label="0.80"];
    "decision_1" -> "maneuver_2" [label="0.80"];
    "maneuver_3" -> "decision_2" [label="0.85"];
    "decision_3" -> "collision_outcome" [label="0.90"];
    "maneuver_0" -> "collision_outcome" [label="0.70"];
    "maneuver_1" -> "collision_outcome" [label="0.80"];
    "maneuver_2" -> "collision_outcome" [label="0.90"];
    "maneuver_3" -> "collision_outcome" [label="0.80"];
    "decision_0" -> "collision_outcome" [label="0.70"];
    "decision_1" -> "collision_outcome" [label="0.70"];
    "decision_2" -> "collision_outcome" [label="0.70"];
}