digraph GroundedDAG {
    rankdir=TB;
    node [shape=box, style=filled];

    // Layer 0: Initial States
    subgraph cluster_0 {
        label="Layer 0: Initial States";
        style=dashed;
        "ego_initial_position" [label="Ego Initial Position\n{'x': 0.0, 'y': 0.0}", fillcolor=skyblue];
        "ego_initial_speed" [label="Ego Initial Speed\n0.000198737659957259", fillcolor=skyblue];
        "ego_initial_heading" [label="Ego Initial Heading\n0.17048677802085876", fillcolor=skyblue];
        "agent_762_state" [label="Vehicle agent_762\n{'position': (1653.1", fillcolor=plum];
        "agent_763_state" [label="Vehicle agent_763\n{'position': (1635.9", fillcolor=plum];
        "agent_755_state" [label="Vehicle agent_755\n{'position': (1654.4", fillcolor=plum];
        "agent_756_state" [label="Vehicle agent_756\n{'position': (1626.2", fillcolor=plum];
        "agent_757_state" [label="Vehicle agent_757\n{'position': (1656.7", fillcolor=plum];
    }

    // Layer 1: Events
    subgraph cluster_1 {
        label="Layer 1: Events";
        style=dashed;
        "maneuver_0" [label="Maneuver: straight\nstraight", fillcolor=turquoise];
        "maneuver_1" [label="Maneuver: decelerate\ndecelerate", fillcolor=turquoise];
        "maneuver_2" [label="Maneuver: stop\nstop", fillcolor=turquoise];
        "maneuver_3" [label="Maneuver: left_turn\nleft_turn", fillcolor=turquoise];
        "maneuver_4" [label="Maneuver: accelerate\naccelerate", fillcolor=turquoise];
        "decision_0" [label="Decision: proceed_or_yield\nproceed through intersection", fillcolor=coral];
        "decision_1" [label="Decision: lane_choice\nstay in current lane", fillcolor=coral];
        "decision_2" [label="Decision: speed_choice\nmaintain speed", fillcolor=coral];
    }

    // Layer 2: Outcome
    subgraph cluster_2 {
        label="Layer 2: Outcome";
        style=dashed;
        "collision_outcome" [label="Collision Outcome", fillcolor=orange];
    }

    "ego_initial_position" -> "maneuver_0" [label="0.80"];
    "ego_initial_speed" -> "maneuver_0" [label="0.80"];
    "ego_initial_heading" -> "maneuver_0" [label="0.80"];
    "maneuver_0" -> "maneuver_1" [label="0.90"];
    "maneuver_1" -> "maneuver_2" [label="0.90"];
    "maneuver_2" -> "maneuver_3" [label="0.90"];
    "maneuver_3" -> "maneuver_4" [label="0.90"];
    "maneuver_2" -> "decision_0" [label="0.80"];
    "decision_0" -> "maneuver_3" [label="0.80"];
    "maneuver_3" -> "decision_1" [label="0.80"];
    "decision_1" -> "maneuver_4" [label="0.80"];
    "maneuver_4" -> "decision_2" [label="0.80"];
    "decision_2" -> "collision_outcome" [label="0.90"];
    "agent_762_state" -> "decision_0" [label="0.70"];
    "agent_763_state" -> "decision_0" [label="0.70"];
    "agent_755_state" -> "decision_0" [label="0.70"];
    "agent_756_state" -> "decision_0" [label="0.70"];
    "agent_757_state" -> "decision_0" [label="0.70"];
    "maneuver_0" -> "collision_outcome" [label="0.60"];
    "maneuver_1" -> "collision_outcome" [label="0.70"];
    "maneuver_2" -> "collision_outcome" [label="0.80"];
    "maneuver_3" -> "collision_outcome" [label="0.80"];
    "maneuver_4" -> "collision_outcome" [label="0.70"];
    "decision_0" -> "collision_outcome" [label="0.70"];
    "decision_1" -> "collision_outcome" [label="0.70"];
}