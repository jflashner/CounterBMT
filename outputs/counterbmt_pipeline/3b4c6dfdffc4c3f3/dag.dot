digraph GroundedDAG {
    rankdir=TB;
    node [shape=box, style=filled];

    // Layer 0: Initial States
    subgraph cluster_0 {
        label="Layer 0: Initial States";
        style=dashed;
        "ego_initial_position" [label="Ego Initial Position\n{'x': 0.0, 'y': 0.0}", fillcolor=skyblue];
        "ego_initial_speed" [label="Ego Initial Speed\n0.23825930058956146", fillcolor=skyblue];
        "ego_initial_heading" [label="Ego Initial Heading\n-3.1411819458007812", fillcolor=skyblue];
        "agent_2101_state" [label="Pedestrian agent_2101\n{'position': (-3219.", fillcolor=plum];
        "agent_2102_state" [label="Pedestrian agent_2102\n{'position': (-3240.", fillcolor=plum];
        "agent_2103_state" [label="Pedestrian agent_2103\n{'position': (-3241.", fillcolor=plum];
        "agent_2105_state" [label="Pedestrian agent_2105\n{'position': (-3241.", fillcolor=plum];
        "agent_885_state" [label="Vehicle agent_885\n{'position': (-3239.", fillcolor=plum];
    }

    // Layer 1: Events
    subgraph cluster_1 {
        label="Layer 1: Events";
        style=dashed;
        "maneuver_0" [label="Maneuver: straight\nstraight", fillcolor=turquoise];
        "maneuver_1" [label="Maneuver: lane_change_right\nlane_change_right", fillcolor=turquoise];
        "maneuver_2" [label="Maneuver: right_turn\nright_turn", fillcolor=turquoise];
        "decision_0" [label="Decision: proceed_or_yield\nproceed through intersection", fillcolor=coral];
        "decision_1" [label="Decision: evasive_action\nmaintain course", fillcolor=coral];
        "decision_2" [label="Decision: gap_acceptance\naccept gap and merge", fillcolor=coral];
    }

    // Layer 2: Outcome
    subgraph cluster_2 {
        label="Layer 2: Outcome";
        style=dashed;
        "collision_outcome" [label="Collision Outcome", fillcolor=orange];
    }

    "ego_initial_position" -> "maneuver_0" [label="0.80"];
    "ego_initial_speed" -> "maneuver_0" [label="0.80"];
    "ego_initial_heading" -> "maneuver_0" [label="0.80"];
    "agent_2101_state" -> "decision_0" [label="0.70"];
    "agent_2102_state" -> "decision_0" [label="0.70"];
    "agent_2103_state" -> "decision_0" [label="0.90"];
    "agent_2105_state" -> "decision_0" [label="0.70"];
    "agent_885_state" -> "decision_1" [label="0.90"];
    "maneuver_0" -> "maneuver_1" [label="0.80"];
    "maneuver_1" -> "maneuver_2" [label="0.80"];
    "decision_0" -> "maneuver_1" [label="0.90"];
    "decision_1" -> "maneuver_2" [label="0.90"];
    "decision_2" -> "maneuver_2" [label="0.85"];
    "maneuver_2" -> "collision_outcome" [label="0.90"];
    "decision_0" -> "collision_outcome" [label="0.90"];
    "decision_1" -> "collision_outcome" [label="0.90"];
    "decision_2" -> "collision_outcome" [label="0.85"];
    "maneuver_0" -> "collision_outcome" [label="0.70"];
    "maneuver_1" -> "collision_outcome" [label="0.70"];
}