digraph GroundedDAG {
    rankdir=TB;
    node [shape=box, style=filled];

    // Layer 0: Initial States
    subgraph cluster_0 {
        label="Layer 0: Initial States";
        style=dashed;
        "ego_initial_position" [label="Ego Initial Position\n{'x': 0.0, 'y': 0.0}", fillcolor=skyblue];
        "ego_initial_speed" [label="Ego Initial Speed\n0.000617004930973053", fillcolor=skyblue];
        "ego_initial_heading" [label="Ego Initial Heading\n-1.5671530961990356", fillcolor=skyblue];
        "agent_682_state" [label="Vehicle agent_682\n{'position': (-907.6", fillcolor=plum];
        "agent_684_state" [label="Vehicle agent_684\n{'position': (-944.6", fillcolor=plum];
    }

    // Layer 1: Events
    subgraph cluster_1 {
        label="Layer 1: Events";
        style=dashed;
        "maneuver_0" [label="Maneuver: right_turn\nright_turn", fillcolor=turquoise];
        "maneuver_1" [label="Maneuver: accelerate\naccelerate", fillcolor=turquoise];
        "decision_0" [label="Decision: proceed_or_yield\nproceed through intersection", fillcolor=coral];
        "decision_1" [label="Decision: lane_choice\nstay in current lane", fillcolor=coral];
        "decision_2" [label="Decision: gap_acceptance\naccept gap and merge", fillcolor=coral];
    }

    // Layer 2: Outcome
    subgraph cluster_2 {
        label="Layer 2: Outcome";
        style=dashed;
        "collision_outcome" [label="Collision Outcome", fillcolor=orange];
    }

    "ego_initial_position" -> "maneuver_0" [label="0.80"];
    "ego_initial_speed" -> "maneuver_0" [label="0.80"];
    "ego_initial_heading" -> "maneuver_0" [label="0.80"];
    "agent_682_state" -> "decision_0" [label="0.90"];
    "agent_684_state" -> "decision_0" [label="0.90"];
    "maneuver_0" -> "maneuver_1" [label="0.90"];
    "decision_0" -> "maneuver_1" [label="0.90"];
    "maneuver_1" -> "decision_1" [label="0.80"];
    "decision_1" -> "decision_2" [label="0.80"];
    "decision_2" -> "collision_outcome" [label="0.90"];
    "maneuver_1" -> "collision_outcome" [label="0.80"];
    "maneuver_0" -> "collision_outcome" [label="0.80"];
    "decision_0" -> "collision_outcome" [label="0.70"];
    "decision_1" -> "collision_outcome" [label="0.70"];
}