digraph GroundedDAG {
    rankdir=TB;
    node [shape=box, style=filled];

    // Layer 0: Initial States
    subgraph cluster_0 {
        label="Layer 0: Initial States";
        style=dashed;
        "ego_initial_position" [label="Ego Initial Position\n{'x': 0.0, 'y': 0.0}", fillcolor=skyblue];
        "ego_initial_speed" [label="Ego Initial Speed\n6.276791095733643", fillcolor=skyblue];
        "ego_initial_heading" [label="Ego Initial Heading\n-3.012949228286743", fillcolor=skyblue];
        "agent_401_state" [label="Vehicle agent_401\n{'position': (42.849", fillcolor=plum];
        "agent_402_state" [label="Vehicle agent_402\n{'position': (35.105", fillcolor=plum];
        "agent_403_state" [label="Vehicle agent_403\n{'position': (71.264", fillcolor=plum];
        "agent_404_state" [label="Vehicle agent_404\n{'position': (74.746", fillcolor=plum];
        "agent_405_state" [label="Vehicle agent_405\n{'position': (39.507", fillcolor=plum];
    }

    // Layer 1: Events
    subgraph cluster_1 {
        label="Layer 1: Events";
        style=dashed;
        "maneuver_0" [label="Maneuver: lane_change_right\nlane_change_right", fillcolor=turquoise];
        "maneuver_1" [label="Maneuver: straight\nstraight", fillcolor=turquoise];
        "maneuver_2" [label="Maneuver: lane_change_left\nlane_change_left", fillcolor=turquoise];
        "maneuver_3" [label="Maneuver: straight\nstraight", fillcolor=turquoise];
        "decision_0" [label="Decision: lane_choice\nMaintained lane position", fillcolor=coral];
        "decision_1" [label="Decision: gap_acceptance\nAccepted gap to merge", fillcolor=coral];
        "decision_2" [label="Decision: speed_choice\nMaintained speed", fillcolor=coral];
    }

    // Layer 2: Outcome
    subgraph cluster_2 {
        label="Layer 2: Outcome";
        style=dashed;
        "collision_outcome" [label="Collision Outcome", fillcolor=orange];
    }

    "ego_initial_position" -> "maneuver_0" [label="0.80"];
    "ego_initial_speed" -> "maneuver_0" [label="0.80"];
    "ego_initial_heading" -> "maneuver_0" [label="0.80"];
    "agent_401_state" -> "decision_0" [label="0.90"];
    "agent_402_state" -> "decision_0" [label="0.90"];
    "agent_403_state" -> "decision_0" [label="0.90"];
    "agent_404_state" -> "decision_0" [label="0.90"];
    "agent_405_state" -> "decision_0" [label="0.90"];
    "maneuver_0" -> "maneuver_1" [label="0.70"];
    "maneuver_1" -> "maneuver_2" [label="0.70"];
    "maneuver_2" -> "maneuver_3" [label="0.70"];
    "decision_0" -> "maneuver_1" [label="0.80"];
    "decision_1" -> "maneuver_2" [label="0.90"];
    "decision_2" -> "maneuver_3" [label="0.85"];
    "maneuver_0" -> "collision_outcome" [label="0.70"];
    "maneuver_1" -> "collision_outcome" [label="0.70"];
    "maneuver_2" -> "collision_outcome" [label="0.70"];
    "maneuver_3" -> "collision_outcome" [label="0.70"];
    "decision_0" -> "collision_outcome" [label="0.80"];
    "decision_1" -> "collision_outcome" [label="0.90"];
    "decision_2" -> "collision_outcome" [label="0.85"];
}