digraph GroundedDAG {
    rankdir=TB;
    node [shape=box, style=filled];

    // Layer 0: Initial States
    subgraph cluster_0 {
        label="Layer 0: Initial States";
        style=dashed;
        "ego_initial_position" [label="Ego Initial Position\n{'x': 0.0, 'y': 0.0}", fillcolor=skyblue];
        "ego_initial_speed" [label="Ego Initial Speed\n0.00051291094860062", fillcolor=skyblue];
        "ego_initial_heading" [label="Ego Initial Heading\n3.0790960788726807", fillcolor=skyblue];
        "agent_1408_state" [label="Vehicle agent_1408\n{'position': (2647.4", fillcolor=plum];
        "agent_1410_state" [label="Vehicle agent_1410\n{'position': (2557.4", fillcolor=plum];
        "agent_1411_state" [label="Vehicle agent_1411\n{'position': (2571.5", fillcolor=plum];
        "agent_1412_state" [label="Vehicle agent_1412\n{'position': (2552.1", fillcolor=plum];
        "agent_1413_state" [label="Vehicle agent_1413\n{'position': (2638.2", fillcolor=plum];
    }

    // Layer 1: Events
    subgraph cluster_1 {
        label="Layer 1: Events";
        style=dashed;
        "maneuver_0" [label="Maneuver: straight\nstraight", fillcolor=turquoise];
        "maneuver_1" [label="Maneuver: decelerate\ndecelerate", fillcolor=turquoise];
        "maneuver_2" [label="Maneuver: stop\nstop", fillcolor=turquoise];
        "maneuver_3" [label="Maneuver: left_turn\nleft_turn", fillcolor=turquoise];
        "maneuver_4" [label="Maneuver: accelerate\naccelerate", fillcolor=turquoise];
        "decision_0" [label="Decision: proceed_or_yield\nproceed through intersection", fillcolor=coral];
        "decision_1" [label="Decision: gap_acceptance\naccept gap and merge", fillcolor=coral];
        "decision_2" [label="Decision: evasive_action\nmaintain course", fillcolor=coral];
    }

    // Layer 2: Outcome
    subgraph cluster_2 {
        label="Layer 2: Outcome";
        style=dashed;
        "collision_outcome" [label="Collision Outcome", fillcolor=orange];
    }

    "ego_initial_position" -> "maneuver_0" [label="0.80"];
    "ego_initial_speed" -> "maneuver_0" [label="0.80"];
    "ego_initial_heading" -> "maneuver_0" [label="0.80"];
    "agent_1408_state" -> "decision_0" [label="0.70"];
    "agent_1410_state" -> "decision_0" [label="0.70"];
    "agent_1411_state" -> "decision_0" [label="0.70"];
    "agent_1412_state" -> "decision_0" [label="0.70"];
    "agent_1413_state" -> "decision_0" [label="0.70"];
    "maneuver_0" -> "maneuver_1" [label="0.90"];
    "maneuver_1" -> "maneuver_2" [label="0.90"];
    "maneuver_2" -> "maneuver_3" [label="0.90"];
    "maneuver_3" -> "maneuver_4" [label="0.90"];
    "decision_0" -> "maneuver_1" [label="0.80"];
    "decision_1" -> "maneuver_3" [label="0.80"];
    "decision_2" -> "maneuver_4" [label="0.80"];
    "maneuver_1" -> "collision_outcome" [label="0.70"];
    "maneuver_2" -> "collision_outcome" [label="0.70"];
    "maneuver_3" -> "collision_outcome" [label="0.70"];
    "maneuver_4" -> "collision_outcome" [label="0.70"];
    "decision_0" -> "collision_outcome" [label="0.80"];
    "decision_1" -> "collision_outcome" [label="0.80"];
    "decision_2" -> "collision_outcome" [label="0.80"];
    "maneuver_0" -> "collision_outcome" [label="0.70"];
}