digraph GroundedDAG {
    rankdir=TB;
    node [shape=box, style=filled];

    // Layer 0: Initial States
    subgraph cluster_0 {
        label="Layer 0: Initial States";
        style=dashed;
        "ego_initial_position" [label="Ego Initial Position\n{'x': 0.0, 'y': 0.0}", fillcolor=skyblue];
        "ego_initial_speed" [label="Ego Initial Speed\n4.740095615386963", fillcolor=skyblue];
        "ego_initial_heading" [label="Ego Initial Heading\n0.1465260535478592", fillcolor=skyblue];
        "agent_653_state" [label="Vehicle agent_653\n{'position': (1894.0", fillcolor=plum];
        "agent_654_state" [label="Vehicle agent_654\n{'position': (1890.7", fillcolor=plum];
        "agent_655_state" [label="Vehicle agent_655\n{'position': (1901.0", fillcolor=plum];
        "agent_656_state" [label="Vehicle agent_656\n{'position': (1887.9", fillcolor=plum];
        "agent_658_state" [label="Vehicle agent_658\n{'position': (1885.0", fillcolor=plum];
    }

    // Layer 1: Events
    subgraph cluster_1 {
        label="Layer 1: Events";
        style=dashed;
        "maneuver_0" [label="Maneuver: straight\nstraight", fillcolor=turquoise];
        "maneuver_1" [label="Maneuver: right_turn\nright_turn", fillcolor=turquoise];
        "maneuver_2" [label="Maneuver: straight\nstraight", fillcolor=turquoise];
        "decision_0" [label="Decision: proceed_or_yield\nproceed through intersection", fillcolor=coral];
        "decision_1" [label="Decision: lane_choice\nstay in current lane", fillcolor=coral];
        "decision_2" [label="Decision: evasive_action\nmaintain speed and direction", fillcolor=coral];
    }

    // Layer 2: Outcome
    subgraph cluster_2 {
        label="Layer 2: Outcome";
        style=dashed;
        "collision_outcome" [label="Collision Outcome", fillcolor=orange];
    }

    "ego_initial_position" -> "maneuver_0" [label="0.80"];
    "ego_initial_speed" -> "maneuver_0" [label="0.80"];
    "ego_initial_heading" -> "maneuver_0" [label="0.80"];
    "agent_653_state" -> "decision_0" [label="0.70"];
    "agent_654_state" -> "decision_0" [label="0.70"];
    "agent_655_state" -> "decision_0" [label="0.70"];
    "agent_656_state" -> "decision_0" [label="0.70"];
    "agent_658_state" -> "decision_0" [label="0.70"];
    "decision_0" -> "maneuver_0" [label="0.90"];
    "maneuver_0" -> "maneuver_1" [label="0.80"];
    "maneuver_1" -> "maneuver_2" [label="0.80"];
    "maneuver_1" -> "decision_1" [label="0.70"];
    "decision_1" -> "maneuver_2" [label="0.80"];
    "maneuver_2" -> "decision_2" [label="0.90"];
    "decision_2" -> "collision_outcome" [label="0.90"];
    "maneuver_0" -> "collision_outcome" [label="0.70"];
    "maneuver_1" -> "collision_outcome" [label="0.70"];
    "maneuver_2" -> "collision_outcome" [label="0.70"];
    "decision_0" -> "collision_outcome" [label="0.70"];
    "decision_1" -> "collision_outcome" [label="0.70"];
}