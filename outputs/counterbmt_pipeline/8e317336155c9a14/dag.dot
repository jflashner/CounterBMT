digraph GroundedDAG {
    rankdir=TB;
    node [shape=box, style=filled];

    // Layer 0: Initial States
    subgraph cluster_0 {
        label="Layer 0: Initial States";
        style=dashed;
        "ego_initial_position" [label="Ego Initial Position\n{'x': 0.0, 'y': 0.0}", fillcolor=skyblue];
        "ego_initial_speed" [label="Ego Initial Speed\n1.403786063194275", fillcolor=skyblue];
        "ego_initial_heading" [label="Ego Initial Heading\n-0.35653454065322876", fillcolor=skyblue];
        "agent_2183_state" [label="Vehicle agent_2183\n{'position': (8154.7", fillcolor=plum];
        "agent_2185_state" [label="Vehicle agent_2185\n{'position': (8196.3", fillcolor=plum];
        "agent_2186_state" [label="Vehicle agent_2186\n{'position': (8161.7", fillcolor=plum];
        "agent_2188_state" [label="Vehicle agent_2188\n{'position': (8151.1", fillcolor=plum];
        "agent_2189_state" [label="Vehicle agent_2189\n{'position': (8131.9", fillcolor=plum];
    }

    // Layer 1: Events
    subgraph cluster_1 {
        label="Layer 1: Events";
        style=dashed;
        "maneuver_0" [label="Maneuver: straight\nstraight", fillcolor=turquoise];
        "maneuver_1" [label="Maneuver: right_turn\nright_turn", fillcolor=turquoise];
        "maneuver_2" [label="Maneuver: straight\nstraight", fillcolor=turquoise];
        "decision_0" [label="Decision: proceed_or_yield\nproceed", fillcolor=coral];
        "decision_1" [label="Decision: lane_choice\nstay in current lane", fillcolor=coral];
        "decision_2" [label="Decision: evasive_action\nmaintain speed", fillcolor=coral];
    }

    // Layer 2: Outcome
    subgraph cluster_2 {
        label="Layer 2: Outcome";
        style=dashed;
        "collision_outcome" [label="Collision Outcome", fillcolor=orange];
    }

    "ego_initial_position" -> "maneuver_0" [label="0.80"];
    "ego_initial_speed" -> "maneuver_0" [label="0.80"];
    "ego_initial_heading" -> "maneuver_0" [label="0.80"];
    "agent_2183_state" -> "decision_0" [label="0.70"];
    "agent_2185_state" -> "decision_0" [label="0.70"];
    "agent_2186_state" -> "decision_0" [label="0.70"];
    "agent_2188_state" -> "decision_0" [label="0.70"];
    "agent_2189_state" -> "decision_0" [label="0.70"];
    "maneuver_0" -> "maneuver_1" [label="0.90"];
    "decision_0" -> "maneuver_1" [label="0.80"];
    "maneuver_1" -> "maneuver_2" [label="0.90"];
    "decision_1" -> "maneuver_2" [label="0.80"];
    "decision_2" -> "maneuver_2" [label="0.90"];
    "maneuver_0" -> "collision_outcome" [label="0.60"];
    "maneuver_1" -> "collision_outcome" [label="0.70"];
    "maneuver_2" -> "collision_outcome" [label="0.70"];
    "decision_0" -> "collision_outcome" [label="0.80"];
    "decision_1" -> "collision_outcome" [label="0.70"];
    "decision_2" -> "collision_outcome" [label="0.80"];
}