digraph GroundedDAG {
    rankdir=TB;
    node [shape=box, style=filled];

    // Layer 0: Initial States
    subgraph cluster_0 {
        label="Layer 0: Initial States";
        style=dashed;
        "ego_initial_position" [label="Ego Initial Position\n{'x': 0.0, 'y': 0.0}", fillcolor=skyblue];
        "ego_initial_speed" [label="Ego Initial Speed\n0.5516017079353333", fillcolor=skyblue];
        "ego_initial_heading" [label="Ego Initial Heading\n1.5723304748535156", fillcolor=skyblue];
        "agent_3252_state" [label="Pedestrian agent_3252\n{'position': (308.75", fillcolor=plum];
        "agent_3254_state" [label="Pedestrian agent_3254\n{'position': (359.40", fillcolor=plum];
        "agent_1306_state" [label="Vehicle agent_1306\n{'position': (301.51", fillcolor=plum];
        "agent_1307_state" [label="Vehicle agent_1307\n{'position': (309.19", fillcolor=plum];
        "agent_1308_state" [label="Vehicle agent_1308\n{'position': (297.70", fillcolor=plum];
    }

    // Layer 1: Events
    subgraph cluster_1 {
        label="Layer 1: Events";
        style=dashed;
        "maneuver_0" [label="Maneuver: decelerate\ndecelerate", fillcolor=turquoise];
        "maneuver_1" [label="Maneuver: stop\nstop", fillcolor=turquoise];
        "maneuver_2" [label="Maneuver: accelerate\naccelerate", fillcolor=turquoise];
        "maneuver_3" [label="Maneuver: straight\nstraight", fillcolor=turquoise];
        "maneuver_4" [label="Maneuver: decelerate\ndecelerate", fillcolor=turquoise];
        "maneuver_5" [label="Maneuver: stop\nstop", fillcolor=turquoise];
        "maneuver_6" [label="Maneuver: accelerate\naccelerate", fillcolor=turquoise];
        "decision_0" [label="Decision: proceed_or_yield\nproceed through intersection", fillcolor=coral];
        "decision_1" [label="Decision: lane_choice\nstay in current lane", fillcolor=coral];
        "decision_2" [label="Decision: evasive_action\nmaintain speed and lane", fillcolor=coral];
    }

    // Layer 2: Outcome
    subgraph cluster_2 {
        label="Layer 2: Outcome";
        style=dashed;
        "collision_outcome" [label="Collision Outcome", fillcolor=orange];
    }

    "ego_initial_position" -> "maneuver_0" [label="0.80"];
    "ego_initial_speed" -> "maneuver_0" [label="0.90"];
    "ego_initial_heading" -> "maneuver_0" [label="0.70"];
    "agent_3252_state" -> "decision_0" [label="0.60"];
    "agent_3254_state" -> "decision_0" [label="0.60"];
    "agent_1306_state" -> "decision_0" [label="0.70"];
    "agent_1307_state" -> "decision_0" [label="0.70"];
    "agent_1308_state" -> "decision_0" [label="0.70"];
    "maneuver_0" -> "maneuver_1" [label="0.90"];
    "maneuver_1" -> "maneuver_2" [label="0.90"];
    "maneuver_2" -> "maneuver_3" [label="0.80"];
    "maneuver_3" -> "maneuver_4" [label="0.70"];
    "maneuver_4" -> "maneuver_5" [label="0.80"];
    "maneuver_5" -> "maneuver_6" [label="0.90"];
    "decision_0" -> "maneuver_3" [label="0.80"];
    "decision_1" -> "maneuver_4" [label="0.70"];
    "decision_2" -> "maneuver_5" [label="0.90"];
    "maneuver_0" -> "collision_outcome" [label="0.70"];
    "maneuver_1" -> "collision_outcome" [label="0.80"];
    "maneuver_2" -> "collision_outcome" [label="0.70"];
    "maneuver_3" -> "collision_outcome" [label="0.70"];
    "maneuver_4" -> "collision_outcome" [label="0.60"];
    "maneuver_5" -> "collision_outcome" [label="0.70"];
    "maneuver_6" -> "collision_outcome" [label="0.70"];
    "decision_0" -> "collision_outcome" [label="0.70"];
    "decision_1" -> "collision_outcome" [label="0.70"];
    "decision_2" -> "collision_outcome" [label="0.70"];
}