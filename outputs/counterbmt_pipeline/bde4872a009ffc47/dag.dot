digraph GroundedDAG {
    rankdir=TB;
    node [shape=box, style=filled];

    // Layer 0: Initial States
    subgraph cluster_0 {
        label="Layer 0: Initial States";
        style=dashed;
        "ego_initial_position" [label="Ego Initial Position\n{'x': 0.0, 'y': 0.0}", fillcolor=skyblue];
        "ego_initial_speed" [label="Ego Initial Speed\n0.02038539946079254", fillcolor=skyblue];
        "ego_initial_heading" [label="Ego Initial Heading\n0.7452288269996643", fillcolor=skyblue];
        "agent_245_state" [label="Vehicle agent_245\n{'position': (-617.0", fillcolor=plum];
        "agent_1779_state" [label="Pedestrian agent_1779\n{'position': (-645.7", fillcolor=plum];
        "agent_248_state" [label="Vehicle agent_248\n{'position': (-612.1", fillcolor=plum];
        "agent_1776_state" [label="Pedestrian agent_1776\n{'position': (-629.6", fillcolor=plum];
        "agent_169_state" [label="Vehicle agent_169\n{'position': (-589.7", fillcolor=plum];
    }

    // Layer 1: Events
    subgraph cluster_1 {
        label="Layer 1: Events";
        style=dashed;
        "maneuver_0" [label="Maneuver: straight\nstraight", fillcolor=turquoise];
        "maneuver_1" [label="Maneuver: lane_change_left\nlane_change_left", fillcolor=turquoise];
        "maneuver_2" [label="Maneuver: left_turn\nleft_turn", fillcolor=turquoise];
        "maneuver_3" [label="Maneuver: straight\nstraight", fillcolor=turquoise];
        "decision_0" [label="Decision: proceed_or_yield\nproceed through intersection", fillcolor=coral];
        "decision_1" [label="Decision: lane_choice\nstay in current lane", fillcolor=coral];
        "decision_2" [label="Decision: gap_acceptance\naccept gap and merge", fillcolor=coral];
    }

    // Layer 2: Outcome
    subgraph cluster_2 {
        label="Layer 2: Outcome";
        style=dashed;
        "collision_outcome" [label="Collision Outcome", fillcolor=orange];
    }

    "ego_initial_position" -> "maneuver_0" [label="0.80"];
    "ego_initial_speed" -> "maneuver_0" [label="0.80"];
    "ego_initial_heading" -> "maneuver_0" [label="0.80"];
    "agent_245_state" -> "decision_0" [label="0.70"];
    "agent_1779_state" -> "decision_0" [label="0.70"];
    "agent_248_state" -> "decision_0" [label="0.70"];
    "agent_1776_state" -> "decision_0" [label="0.70"];
    "agent_169_state" -> "decision_0" [label="0.70"];
    "maneuver_0" -> "maneuver_1" [label="0.90"];
    "maneuver_1" -> "maneuver_2" [label="0.90"];
    "maneuver_2" -> "maneuver_3" [label="0.90"];
    "decision_0" -> "maneuver_1" [label="0.80"];
    "decision_1" -> "maneuver_3" [label="0.90"];
    "decision_2" -> "maneuver_3" [label="0.70"];
    "maneuver_0" -> "collision_outcome" [label="0.60"];
    "maneuver_1" -> "collision_outcome" [label="0.70"];
    "maneuver_2" -> "collision_outcome" [label="0.80"];
    "maneuver_3" -> "collision_outcome" [label="0.60"];
    "decision_0" -> "collision_outcome" [label="0.80"];
    "decision_1" -> "collision_outcome" [label="0.90"];
    "decision_2" -> "collision_outcome" [label="0.70"];
}