digraph GroundedDAG {
    rankdir=TB;
    node [shape=box, style=filled];

    // Layer 0: Initial States
    subgraph cluster_0 {
        label="Layer 0: Initial States";
        style=dashed;
        "ego_initial_position" [label="Ego Initial Position\n{'x': 0.0, 'y': 0.0}", fillcolor=skyblue];
        "ego_initial_speed" [label="Ego Initial Speed\n0.000143445620778948", fillcolor=skyblue];
        "ego_initial_heading" [label="Ego Initial Heading\n1.4727150201797485", fillcolor=skyblue];
        "agent_198_state" [label="Vehicle agent_198\n{'position': (380.24", fillcolor=plum];
        "agent_199_state" [label="Vehicle agent_199\n{'position': (387.28", fillcolor=plum];
        "agent_200_state" [label="Vehicle agent_200\n{'position': (350.77", fillcolor=plum];
        "agent_201_state" [label="Vehicle agent_201\n{'position': (378.81", fillcolor=plum];
        "agent_202_state" [label="Vehicle agent_202\n{'position': (417.53", fillcolor=plum];
    }

    // Layer 1: Events
    subgraph cluster_1 {
        label="Layer 1: Events";
        style=dashed;
        "maneuver_0" [label="Maneuver: straight\nstraight", fillcolor=turquoise];
        "maneuver_1" [label="Maneuver: decelerate\ndecelerate", fillcolor=turquoise];
        "maneuver_2" [label="Maneuver: stop\nstop", fillcolor=turquoise];
        "maneuver_3" [label="Maneuver: straight\nstraight", fillcolor=turquoise];
        "maneuver_4" [label="Maneuver: accelerate\naccelerate", fillcolor=turquoise];
        "maneuver_5" [label="Maneuver: straight\nstraight", fillcolor=turquoise];
        "decision_0" [label="Decision: proceed_or_yield\nproceed through intersection", fillcolor=coral];
        "decision_1" [label="Decision: lane_choice\nstay in current lane", fillcolor=coral];
        "decision_2" [label="Decision: gap_acceptance\naccept gap to merge", fillcolor=coral];
    }

    // Layer 2: Outcome
    subgraph cluster_2 {
        label="Layer 2: Outcome";
        style=dashed;
        "collision_outcome" [label="Collision Outcome", fillcolor=orange];
    }

    "ego_initial_position" -> "maneuver_0" [label="0.80"];
    "ego_initial_speed" -> "maneuver_0" [label="0.80"];
    "ego_initial_heading" -> "maneuver_0" [label="0.80"];
    "agent_198_state" -> "decision_0" [label="0.70"];
    "agent_199_state" -> "decision_0" [label="0.70"];
    "agent_200_state" -> "decision_0" [label="0.70"];
    "agent_201_state" -> "decision_0" [label="0.70"];
    "agent_202_state" -> "decision_0" [label="0.70"];
    "maneuver_0" -> "maneuver_1" [label="0.90"];
    "maneuver_1" -> "maneuver_2" [label="0.90"];
    "maneuver_2" -> "decision_0" [label="0.90"];
    "decision_0" -> "maneuver_3" [label="0.90"];
    "maneuver_3" -> "maneuver_4" [label="0.90"];
    "maneuver_4" -> "maneuver_5" [label="0.90"];
    "maneuver_5" -> "decision_1" [label="0.80"];
    "decision_1" -> "decision_2" [label="0.80"];
    "decision_0" -> "collision_outcome" [label="0.90"];
    "decision_1" -> "collision_outcome" [label="0.80"];
    "decision_2" -> "collision_outcome" [label="0.85"];
    "maneuver_0" -> "collision_outcome" [label="0.70"];
    "maneuver_1" -> "collision_outcome" [label="0.70"];
    "maneuver_2" -> "collision_outcome" [label="0.70"];
    "maneuver_3" -> "collision_outcome" [label="0.70"];
    "maneuver_4" -> "collision_outcome" [label="0.70"];
    "maneuver_5" -> "collision_outcome" [label="0.70"];
}