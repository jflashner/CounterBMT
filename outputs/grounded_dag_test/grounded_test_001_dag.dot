digraph GroundedDAG {
    rankdir=TB;
    node [shape=box, style=filled];

    // Layer 0: Initial States
    subgraph cluster_0 {
        label="Layer 0: Initial States";
        style=dashed;
        "ego_initial_position" [label="Ego Initial Position\n{'x': 0.0, 'y': 0.0}", fillcolor=skyblue];
        "ego_initial_speed" [label="Ego Initial Speed\n12.0", fillcolor=skyblue];
        "ego_initial_heading" [label="Ego Initial Heading", fillcolor=skyblue];
        "veh_1_state" [label="Vehicle veh_1\n{'position': (40, -3), 'speed': 15, 'type': 'vehicle'}", fillcolor=plum];
        "veh_2_state" [label="Vehicle veh_2\n{'position': (-10, 5), 'speed': 8, 'type': 'vehicle'}", fillcolor=plum];
    }

    // Layer 1: Events
    subgraph cluster_1 {
        label="Layer 1: Events";
        style=dashed;
        "maneuver_0" [label="Maneuver: left_turn\nleft_turn", fillcolor=turquoise];
        "maneuver_1" [label="Maneuver: straight\nstraight", fillcolor=turquoise];
        "decision_0" [label="Decision: proceed_or_yield\nproceed", fillcolor=coral];
        "decision_1" [label="Decision: gap_acceptance\naccept_gap", fillcolor=coral];
    }

    // Layer 2: Outcome
    subgraph cluster_2 {
        label="Layer 2: Outcome";
        style=dashed;
        "collision_outcome" [label="Collision Outcome", fillcolor=orange];
    }

    "ego_initial_position" -> "maneuver_0" [label="0.70"];
    "ego_initial_position" -> "maneuver_1" [label="0.70"];
    "ego_initial_speed" -> "decision_0" [label="0.80"];
    "ego_initial_speed" -> "decision_1" [label="0.80"];
    "veh_1_state" -> "decision_0" [label="0.85"];
    "veh_1_state" -> "decision_1" [label="0.85"];
    "veh_2_state" -> "decision_0" [label="0.85"];
    "veh_2_state" -> "decision_1" [label="0.85"];
    "decision_0" -> "maneuver_0" [label="0.90"];
    "decision_0" -> "decision_1" [label="0.75"];
    "decision_0" -> "maneuver_1" [label="0.90"];
    "decision_1" -> "maneuver_1" [label="0.90"];
    "maneuver_0" -> "collision_outcome" [label="0.85"];
    "maneuver_1" -> "collision_outcome" [label="0.85"];
    "decision_0" -> "collision_outcome" [label="0.85"];
    "decision_1" -> "collision_outcome" [label="0.85"];
}