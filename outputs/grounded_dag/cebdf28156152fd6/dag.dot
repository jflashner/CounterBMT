digraph GroundedDAG {
    rankdir=TB;
    node [shape=box, style=filled];

    // Layer 0: Initial States
    subgraph cluster_0 {
        label="Layer 0: Initial States";
        style=dashed;
        "ego_initial_position" [label="Ego Initial Position\n{'x': 0.0, 'y': 0.0}", fillcolor=skyblue];
        "ego_initial_speed" [label="Ego Initial Speed\n9.602272033691406", fillcolor=skyblue];
        "ego_initial_heading" [label="Ego Initial Heading\n-0.01147556118667125", fillcolor=skyblue];
        "agent_0_state" [label="Vehicle agent_0\n{'position': (8137.6", fillcolor=plum];
        "agent_1_state" [label="Vehicle agent_1\n{'position': (8138.9", fillcolor=plum];
        "agent_2_state" [label="Vehicle agent_2\n{'position': (8140.6", fillcolor=plum];
        "agent_3_state" [label="Vehicle agent_3\n{'position': (8168.8", fillcolor=plum];
        "agent_4_state" [label="Vehicle agent_4\n{'position': (8134.4", fillcolor=plum];
    }

    // Layer 1: Events
    subgraph cluster_1 {
        label="Layer 1: Events";
        style=dashed;
        "maneuver_0" [label="Maneuver: straight\nstraight", fillcolor=turquoise];
        "maneuver_1" [label="Maneuver: right_turn\nright_turn", fillcolor=turquoise];
        "maneuver_2" [label="Maneuver: decelerate\ndecelerate", fillcolor=turquoise];
        "maneuver_3" [label="Maneuver: accelerate\naccelerate", fillcolor=turquoise];
        "decision_0" [label="Decision: proceed_or_yield\nproceed through intersection", fillcolor=coral];
        "decision_1" [label="Decision: evasive_action\nmaintain course", fillcolor=coral];
    }

    // Layer 2: Outcome
    subgraph cluster_2 {
        label="Layer 2: Outcome";
        style=dashed;
        "collision_outcome" [label="Collision Outcome", fillcolor=orange];
    }

    "ego_initial_position" -> "maneuver_0" [label="0.80"];
    "ego_initial_speed" -> "maneuver_0" [label="0.80"];
    "ego_initial_heading" -> "maneuver_0" [label="0.80"];
    "agent_0_state" -> "decision_0" [label="0.70"];
    "agent_1_state" -> "decision_0" [label="0.70"];
    "agent_2_state" -> "decision_0" [label="0.70"];
    "agent_3_state" -> "decision_0" [label="0.70"];
    "agent_4_state" -> "decision_0" [label="0.70"];
    "maneuver_0" -> "maneuver_1" [label="0.90"];
    "maneuver_1" -> "maneuver_2" [label="0.90"];
    "maneuver_2" -> "decision_0" [label="0.80"];
    "decision_0" -> "maneuver_3" [label="0.80"];
    "maneuver_3" -> "decision_1" [label="0.80"];
    "decision_1" -> "collision_outcome" [label="0.90"];
    "maneuver_1" -> "collision_outcome" [label="0.80"];
    "maneuver_2" -> "collision_outcome" [label="0.80"];
    "maneuver_0" -> "collision_outcome" [label="0.70"];
    "maneuver_3" -> "collision_outcome" [label="0.70"];
    "decision_0" -> "collision_outcome" [label="0.70"];
}