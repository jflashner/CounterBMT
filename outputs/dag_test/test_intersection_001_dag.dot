digraph CausalDAG {
    rankdir=TB;
    node [shape=box, style=filled];

    "maneuver_0" [label="maneuver_0\n(left_turn)", fillcolor=turquoise];
    "maneuver_1" [label="maneuver_1\n(straight)", fillcolor=turquoise];
    "decision_0" [label="decision_0\n(proceed)", fillcolor=coral];
    "decision_1" [label="decision_1\n(maintain_course)", fillcolor=coral];
    "decision_2" [label="decision_2\n(accept_gap)", fillcolor=coral];
    "collision_risk" [label="Collision Risk", fillcolor=orange];

    "maneuver_0" -> "decision_0" [label="0.90"];
    "decision_0" -> "decision_1" [label="0.80"];
    "decision_0" -> "decision_2" [label="0.85"];
    "decision_2" -> "maneuver_1" [label="0.85"];
    "maneuver_1" -> "collision_risk" [label="0.60"];
    "decision_1" -> "collision_risk" [label="0.60"];
}