digraph CausalDAG {
    rankdir=TB;
    node [shape=box, style=filled];

    "weather_conditions" [label="weather_conditions", fillcolor=lightgreen];
    "road_conditions" [label="road_conditions", fillcolor=lightgreen];
    "vehicle_speed" [label="vehicle_speed", fillcolor=skyblue];
    "traffic_signals" [label="traffic_signals", fillcolor=khaki];
    "pedestrian_presence" [label="pedestrian_presence", fillcolor=khaki];
    "obstacle_detection" [label="obstacle_detection", fillcolor=khaki];
    "lane_position" [label="lane_position", fillcolor=skyblue];
    "braking_decision" [label="braking_decision", fillcolor=coral];
    "steering_decision" [label="steering_decision", fillcolor=coral];
    "collision_avoidance_maneuver" [label="collision_avoidance_maneuver", fillcolor=turquoise];
    "collision_outcome" [label="collision_outcome", fillcolor=orange];
    "injury_severity" [label="injury_severity", fillcolor=crimson];

    "weather_conditions" -> "obstacle_detection" [label="0.90"];
    "road_conditions" -> "vehicle_speed" [label="0.90"];
    "vehicle_speed" -> "braking_decision" [label="0.90"];
    "traffic_signals" -> "braking_decision" [label="0.90"];
    "pedestrian_presence" -> "braking_decision" [label="0.90"];
    "obstacle_detection" -> "braking_decision" [label="0.90"];
    "lane_position" -> "steering_decision" [label="0.90"];
    "braking_decision" -> "collision_avoidance_maneuver" [label="0.90"];
    "steering_decision" -> "collision_avoidance_maneuver" [label="0.90"];
    "collision_avoidance_maneuver" -> "collision_outcome" [label="0.90"];
    "collision_outcome" -> "injury_severity" [label="0.90"];
}